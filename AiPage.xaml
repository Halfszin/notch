<UserControl x:Class="Orbi.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource N.Fg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="AiMode"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource N.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource N.Fg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,4,4">
            <TextBlock x:Name="NewChat" DockPanel.Dock="Right" Text="Nova conversa" FontSize="10.5" Foreground="#777" Cursor="Hand"
                       VerticalAlignment="Center" MouseLeftButtonUp="NewChat_Click"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ChatMode" Style="{StaticResource Seg}" Content="Chat" IsChecked="True" Checked="Mode_Checked"/>
                <RadioButton x:Name="AgentsMode" Style="{StaticResource Seg}" Content="Agentes" Checked="Mode_Checked"/>
                <RadioButton x:Name="UsageMode" Style="{StaticResource Seg}" Content="Consumo" Checked="Mode_Checked"/>
            </StackPanel>
        </DockPanel>

        <Grid>
        <!-- Chat -->
        <DockPanel x:Name="ChatPanel">
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource N.Field}" CornerRadius="16" Padding="12,4,4,4" Margin="0,8,4,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="Send_Click" Cursor="Hand" Focusable="False" AutomationProperties.Name="Enviar pergunta">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Width="28" Height="28" CornerRadius="14" Background="White">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="AskHint" Text="Pergunte algo… (Enter envia)" Foreground="#666" FontSize="13" IsHitTestVisible="False" Margin="2,0"/>
                        <TextBox x:Name="AskInput" Background="Transparent" Foreground="{DynamicResource N.Fg}" CaretBrush="{DynamicResource N.Fg}" BorderThickness="0" FontSize="13"
                                 AutomationProperties.Name="Pergunta para a IA" KeyDown="AskInput_KeyDown" TextChanged="AskInput_TextChanged"/>
                    </Grid>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Messages"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Agentes do Claude Code ao vivo -->
        <ScrollViewer x:Name="AgentsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="AgentRows" Margin="2,0,6,0"/>
        </ScrollViewer>

        <!-- Consumo -->
        <ScrollViewer x:Name="UsagePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="UsageRows" Margin="2,0,6,0"/>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
