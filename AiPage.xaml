<UserControl x:Class="Orbi.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="White" FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="AiMode"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="10,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2C2C31"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,4,4">
            <TextBlock x:Name="NewChat" DockPanel.Dock="Right" Text="Nova conversa" FontSize="10.5" Foreground="#777" Cursor="Hand"
                       VerticalAlignment="Center" MouseLeftButtonUp="NewChat_Click"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ChatMode" Style="{StaticResource Seg}" Content="Chat" IsChecked="True" Checked="Mode_Checked"/>
                <RadioButton x:Name="UsageMode" Style="{StaticResource Seg}" Content="Consumo" Checked="Mode_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Chat -->
        <DockPanel x:Name="ChatPanel">
            <Border DockPanel.Dock="Bottom" Background="#1E1E22" CornerRadius="8" Padding="8,4" Margin="0,6,4,0">
                <Grid>
                    <TextBlock x:Name="AskHint" Text="Pergunte algo… (Enter envia)" Foreground="#666" FontSize="12" IsHitTestVisible="False" Margin="2,0"/>
                    <TextBox x:Name="AskInput" Background="Transparent" Foreground="White" CaretBrush="White" BorderThickness="0" FontSize="12"
                             AutomationProperties.Name="Pergunta para a IA" KeyDown="AskInput_KeyDown" TextChanged="AskInput_TextChanged"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Messages"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Consumo -->
        <ScrollViewer x:Name="UsagePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="UsageRows" Margin="2,0,6,0"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
