<Window x:Class="Orbi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Orbi"
        Title="Orbi" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" Foreground="White">
    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#BBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="14" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="b" Property="Background" Value="#1F1F22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Tab"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="14" Padding="11,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="b" Property="Background" Value="#232327"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Vol" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Height="18">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BarBtn}" Background="White" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BarBtn}" Background="#444" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Height="11">
                                        <Thumb.Template>
                                            <ControlTemplate><Ellipse Fill="White"/></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Pill" Background="Black" ClipToBounds="True" Width="120" Height="30"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PillScale"/>
        </Border.RenderTransform>
        <Border.ContextMenu>
            <ContextMenu Closed="Menu_Closed">
                <MenuItem Header="Configurações" Click="Settings_Click"/>
                <Separator/>
                <MenuItem Header="Sair" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <!-- Fechado: anel da bateria (com raio quando carregando) + hora -->
            <StackPanel x:Name="Mini" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid Width="18" Height="18" Margin="3">
                    <Ellipse Stroke="#333" StrokeThickness="3" Margin="1.5"/>
                    <Path x:Name="RingMini" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="BoltMini" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
                <StackPanel x:Name="Bars" Orientation="Horizontal" Margin="3,0" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" Margin="1,0" VerticalAlignment="Center"/>
                    <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" Margin="1,0" VerticalAlignment="Center"/>
                    <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#30D158" Margin="1,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ClockMini" FontWeight="SemiBold" FontSize="13" Margin="3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Aberto -->
            <Grid x:Name="Full" Width="440" Height="226" Opacity="0" IsHitTestVisible="False">
                <Grid Margin="14,6,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Style="{StaticResource Tab}" Content="&#xE80F;" Tag="home" IsChecked="True" Checked="Tab_Checked"
                                         ToolTip="Início" AutomationProperties.Name="Início"/>
                            <RadioButton Style="{StaticResource Tab}" Content="&#xE787;" Tag="calendar" Checked="Tab_Checked"
                                         ToolTip="Calendário e timer" AutomationProperties.Name="Calendário"/>
                        </StackPanel>
                        <Grid DockPanel.Dock="Right">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE713;"
                                    ToolTip="Configurações" AutomationProperties.Name="Configurações" Click="Settings_Click"/>
                            <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="#30D158" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,4,6,0" IsHitTestVisible="False" Visibility="Collapsed" ToolTip="Versão nova pronta"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <Grid Width="18" Height="18" Margin="0,0,5,0">
                                <Ellipse Stroke="#333" StrokeThickness="3" Margin="1.5"/>
                                <Path x:Name="RingFull" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock x:Name="BoltFull" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="BatteryText" FontSize="12" Foreground="#AAA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DateText" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ClockFull" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#141416" CornerRadius="16" BorderBrush="#222226" BorderThickness="1" Padding="10,10,14,10">
                        <Grid>
                        <local:CalendarPage x:Name="CalendarView" Visibility="Collapsed"/>
                        <Grid x:Name="HomePage">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar: clicável (reage aos cliques) e pulsa com a música -->
                            <Button x:Name="AvatarButton" Width="104" Margin="0,0,8,0" Cursor="Hand" Focusable="False"
                                    AutomationProperties.Name="Avatar do Orbi" Click="Avatar_Click"
                                    Visibility="{Binding Visibility, ElementName=Avatar}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                                </Button.Template>
                                <Grid Background="Transparent">
                                    <Ellipse x:Name="Glow" Width="100" Height="100" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform x:Name="GlowScale"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#40FFE2B8" Offset="0"/>
                                                <GradientStop Color="#00FFE2B8" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <local:AvatarView x:Name="Avatar" Width="104" Height="104" RenderTransformOrigin="0.5,0.5">
                                        <local:AvatarView.RenderTransform>
                                            <ScaleTransform x:Name="AvatarScale"/>
                                        </local:AvatarView.RenderTransform>
                                    </local:AvatarView>
                                </Grid>
                            </Button>

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CoverBox" Width="40" Height="40" CornerRadius="8" Background="#222">
                                        <TextBlock x:Name="CoverIcon" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TitleText" Text="Nada tocando" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ArtistText" FontSize="12" Foreground="#999" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Elapsed" Text="0:00" FontSize="11" Foreground="#888"/>
                                    <Border x:Name="ProgressTrack" Grid.Column="1" Height="4" CornerRadius="2" Background="#333" VerticalAlignment="Center">
                                        <Border x:Name="ProgressFill" Width="0" CornerRadius="2" Background="#DDD" HorizontalAlignment="Left"/>
                                    </Border>
                                    <TextBlock x:Name="Remaining" Grid.Column="2" Text="-0:00" FontSize="11" Foreground="#888" HorizontalAlignment="Right"/>
                                </Grid>

                                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#BBB"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Slider x:Name="VolSlider" Style="{StaticResource Vol}" Width="70" ValueChanged="Vol_Changed"
                                                AutomationProperties.Name="Volume"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Tag="prev" Click="Media_Click" AutomationProperties.Name="Anterior"/>
                                        <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="18" Tag="play" Click="Media_Click" AutomationProperties.Name="Tocar ou pausar"/>
                                        <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Tag="next" Click="Media_Click" AutomationProperties.Name="Próxima"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
