<Window x:Class="Notch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notch" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="360" Height="170" FontFamily="Segoe UI" Foreground="White">
    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#BBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Vol" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Height="16">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BarBtn}" Background="White" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource BarBtn}" Background="#444" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="10" Height="10">
                                        <Thumb.Template>
                                            <ControlTemplate><Ellipse Fill="White"/></ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Pill" Background="Black" ClipToBounds="True" Width="120" Height="30"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave">
        <Border.ContextMenu>
            <ContextMenu Closed="Menu_Closed">
                <MenuItem Header="Topo" Tag="Top" Click="Edge_Click"/>
                <MenuItem Header="Esquerda" Tag="Left" Click="Edge_Click"/>
                <MenuItem Header="Direita" Tag="Right" Click="Edge_Click"/>
                <Separator/>
                <MenuItem Header="Sair" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <!-- Fechado: anel da bateria + hora -->
            <StackPanel x:Name="Mini" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="16" Height="16" Margin="3">
                    <Ellipse Stroke="#333" StrokeThickness="3" Margin="1.5"/>
                    <Path x:Name="RingMini" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
                <TextBlock x:Name="ClockMini" FontWeight="SemiBold" FontSize="13" Margin="3"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Aberto -->
            <Grid x:Name="Full" Width="360" Height="170" Visibility="Collapsed">
                <Grid Margin="20,10,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Width="16" Height="16" Margin="0,0,6,0">
                            <Ellipse Stroke="#333" StrokeThickness="3" Margin="1.5"/>
                            <Path x:Name="RingFull" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock x:Name="BatteryText" FontSize="12" Foreground="#AAA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DateText" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClockFull" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CoverBox" Width="52" Height="52" CornerRadius="8" Background="#222">
                            <TextBlock x:Name="CoverIcon" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#777" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Nada tocando" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" FontSize="12" Foreground="#AAA" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Elapsed" Text="0:00" FontSize="11" Foreground="#888"/>
                        <Border x:Name="ProgressTrack" Grid.Column="1" Height="4" CornerRadius="2" Background="#333" VerticalAlignment="Center">
                            <Border x:Name="ProgressFill" Width="0" CornerRadius="2" Background="#DDD" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock x:Name="Remaining" Grid.Column="2" Text="-0:00" FontSize="11" Foreground="#888" HorizontalAlignment="Right"/>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#BBB"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="VolSlider" Style="{StaticResource Vol}" Width="80" ValueChanged="Vol_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Tag="prev" Click="Media_Click"/>
                            <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;" FontSize="20" Tag="play" Click="Media_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Tag="next" Click="Media_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
