<Window x:Class="Orbi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Orbi"
        Title="Orbi" Icon="orbi.ico" Width="900" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#0B0B0C"
        FontFamily="Segoe UI" Foreground="White">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6E6E73"/>
            <Setter Property="Margin" Value="4,26,0,10"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#161618"/>
            <Setter Property="BorderBrush" Value="#232326"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="18,14"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C7C7CC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Edge"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="16,5">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A3A3E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="t" Width="50" Height="28" CornerRadius="14" Background="#3A3A3E">
                            <Ellipse x:Name="k" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#30D158"/>
                                <Setter TargetName="k" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#2A2A2E" CornerRadius="8" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#38383C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <DockPanel Margin="14,18,14,14">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="30" Height="22" CornerRadius="9" Background="White" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="4" Height="6" Fill="Black" Margin="2,0"/>
                            <Ellipse Width="4" Height="6" Fill="Black" Margin="2,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Orbi" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="NOTCH" Style="{StaticResource Label}" Margin="10,0,0,8"/>
                <Border Background="#1C1C1F" CornerRadius="8" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Geral" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Background="#141416" BorderBrush="#232326" BorderThickness="1"
                    CornerRadius="10" Padding="12,9" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#30D158" VerticalAlignment="Center"/>
                    <TextBlock Text="Ativo · passe o mouse no notch" FontSize="12" Foreground="#AEAEB2" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Conteúdo -->
        <Border Grid.Column="1" Margin="0,12,12,12" Background="#111113" BorderBrush="#1E1E21" BorderThickness="1" CornerRadius="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,26,26,30">
                    <Border x:Name="Banner" Height="160" CornerRadius="16" BorderBrush="#26262A" BorderThickness="1" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#050506" Offset="0"/>
                                <GradientStop Color="#0B0B0D" Offset="0.55"/>
                                <GradientStop Color="#2C2C30" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Canvas x:Name="Stars" IsHitTestVisible="False"/>
                            <TextBlock Text="Configurações" FontSize="30" FontWeight="Bold" Margin="26,34,0,0"
                                       VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <local:AvatarView x:Name="BannerAvatar" Width="96" Height="96"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,6"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="NOTCH" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Onde o notch fica" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#232326" CornerRadius="8" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="EdgeTop" Content="Topo" Style="{StaticResource Seg}" Tag="Top" Checked="Edge_Checked"/>
                                        <RadioButton x:Name="EdgeLeft" Content="Esquerda" Style="{StaticResource Seg}" Tag="Left" Checked="Edge_Checked"/>
                                        <RadioButton x:Name="EdgeRight" Content="Direita" Style="{StaticResource Seg}" Tag="Right" Checked="Edge_Checked"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="#232326" Margin="18,0"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Margin="0,0,80,0">
                                    <TextBlock Text="Iniciar com o Windows" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="O notch aparece sozinho quando você liga o PC, sem abrir esta tela." Style="{StaticResource RowSub}"/>
                                </StackPanel>
                                <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          AutomationProperties.Name="Iniciar com o Windows" Click="Startup_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AVATAR" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <StackPanel Margin="0,0,230,0">
                                <TextBlock Text="Arquivo do avatar" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="AvatarStatus" Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="DefaultAvatarBtn" Content="Usar o padrão" Style="{StaticResource PillBtn}" Margin="0,0,8,0" Click="DefaultAvatar_Click"/>
                                <Button Content="Escolher…" Style="{StaticResource PillBtn}" Click="PickAvatar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="APP" Style="{StaticResource Label}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid Style="{StaticResource Row}">
                            <StackPanel Margin="0,0,100,0">
                                <TextBlock Text="Fechar o Orbi" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="O notch some até você abrir o app de novo. Fechar esta janela não fecha o notch." Style="{StaticResource RowSub}"/>
                            </StackPanel>
                            <Button Content="Sair" Style="{StaticResource PillBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Exit_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
