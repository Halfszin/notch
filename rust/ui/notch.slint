    viewbox-height: 257;
    fill: #D97757;
    commands: "m50.228 170.321 50.357-28.257.843-2.463-.843-1.361h-2.462l-8.426-.518-28.775-.778-24.952-1.037-24.175-1.296-6.092-1.297L0 125.796l.583-3.759 5.12-3.434 7.324.648 16.202 1.101 24.304 1.685 17.629 1.037 26.118 2.722h4.148l.583-1.685-1.426-1.037-1.101-1.037-25.147-17.045-27.22-18.017-14.258-10.37-7.713-5.25-3.888-4.925-1.685-10.758 7-7.713 9.397.649 2.398.648 9.527 7.323 20.35 15.75L94.817 91.9l3.889 3.24 1.555-1.102.195-.777-1.75-2.917-14.453-26.118-15.425-26.572-6.87-11.018-1.814-6.61c-.648-2.723-1.102-4.991-1.102-7.778l7.972-10.823L71.42 0 82.05 1.426l4.472 3.888 6.61 15.101 10.694 23.786 16.591 32.34 4.861 9.592 2.592 8.879.973 2.722h1.685v-1.556l1.36-18.211 2.528-22.36 2.463-28.776.843-8.1 4.018-9.722 7.971-5.25 6.222 2.981 5.12 7.324-.713 4.73-3.046 19.768-5.962 30.98-3.889 20.739h2.268l2.593-2.593 10.499-13.934 17.628-22.036 7.778-8.749 9.073-9.657 5.833-4.601h11.018l8.1 12.055-3.628 12.443-11.342 14.388-9.398 12.184-13.48 18.147-8.426 14.518.778 1.166 2.01-.194 30.46-6.481 16.462-2.982 19.637-3.37 8.88 4.148.971 4.213-3.5 8.62-20.998 5.184-24.628 4.926-36.682 8.685-.454.324.519.648 16.526 1.555 7.065.389h17.304l32.21 2.398 8.426 5.574 5.055 6.805-.843 5.184-12.962 6.611-17.498-4.148-40.83-9.721-14-3.5h-1.944v1.167l11.666 11.406 21.387 19.314 26.767 24.887 1.36 6.157-3.434 4.86-3.63-.518-23.526-17.693-9.073-7.972-20.545-17.304h-1.36v1.814l4.73 6.935 25.017 37.59 1.296 11.536-1.814 3.76-6.481 2.268-7.13-1.297-14.647-20.544-15.1-23.138-12.185-20.739-1.49.843-7.194 77.448-3.37 3.953-7.778 2.981-6.48-4.925-3.436-7.972 3.435-15.749 4.148-20.544 3.37-16.333 3.046-20.285 1.815-6.74-.13-.454-1.49.194-15.295 20.999-23.267 31.433-18.406 19.702-4.407 1.75-7.648-3.954.713-7.064 4.277-6.286 25.47-32.405 15.36-20.092 9.917-11.6-.065-1.686h-.583L44.07 198.125l-12.055 1.555-5.185-4.86.648-7.972 2.463-2.593 20.35-13.999-.064.065Z";
}

// Setas "de vidro" (vetor enviado pelo dono): traço branco que esmaece para baixo.
component Chevron inherits Path {
    in property <bool> right;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: @linear-gradient(180deg, #FFFFFF 0%, #FFFFFF8C 100%);
    stroke-width: 2px;
    stroke-line-cap: round;
    commands: root.right ? "M9 6L13.727 10.727A1.8 1.8 0 0 1 13.727 13.273L9 18" : "M15 6L10.273 10.727A1.8 1.8 0 0 0 10.273 13.273L15 18";
}

// Volume: só o ícone; com o mouse em cima ele se abre numa barrinha (clicar, arrastar ou rodinha).
component VolumeHover inherits Rectangle {
    in-out property <float> value;
    in-out property <bool> held;
    callback changed(float);
    property <bool> expanded: ta.has-hover || root.held;
    property <length> track: root.width - 42px;
    width: root.expanded ? 110px : 34px;
    animate width { duration: 200ms; easing: ease-out; }
    height: 30px;
    border-radius: 15px;
    background: root.expanded ? #FFFFFF18 : transparent;
    animate background { duration: 200ms; }
    clip: true;
    Text {
        x: 0; width: 34px; height: parent.height;
        text: root.value < 0.01 ? "\u{E74F}" : root.value < 0.34 ? "\u{E993}" : root.value < 0.67 ? "\u{E994}" : "\u{E995}";
        font-family: "Segoe MDL2 Assets"; font-size: 14px; color: #DDDDDD;
        horizontal-alignment: center; vertical-alignment: center;
    }
    Rectangle { x: 30px; y: 13px; width: root.track; height: 4px; border-radius: 2px; background: #FFFFFF33; opacity: root.expanded ? 1 : 0; }
    Rectangle { x: 30px; y: 13px; width: root.track * clamp(root.value, 0, 1); height: 4px; border-radius: 2px; background: white; opacity: root.expanded ? 1 : 0; }
    Rectangle {
        x: 30px + root.track * clamp(root.value, 0, 1) - 6px; y: 9px;
        width: 12px; height: 12px; border-radius: 6px; background: white;
        opacity: root.expanded ? 1 : 0;
    }
    function set(px: length) {
        root.value = clamp((px - 30px) / root.track, 0, 1);
        root.changed(root.value);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && self.mouse-x > 24px) { root.held = true; root.set(self.mouse-x); }
            if (e.kind == PointerEventKind.up) { root.held = false; }
        }
        moved => { if (root.held) { root.set(self.mouse-x); } }
        scroll-event(e) => {
            root.value = clamp(root.value + (e.delta-y > 0 ? 0.05 : e.delta-y < 0 ? -0.05 : 0), 0, 1);
            root.changed(root.value);
            accept
        }
    }
}

// Botão em pílula (estilo Nusa): ícone + texto.
component Pill inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    background: root.primary ? (ta.has-hover ? #E6E6E6 : white) : (ta.has-hover ? #2C2C31 : #1E1E22);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        if root.glyph != "" : Text { text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: root.primary ? black : white; vertical-alignment: center; }
        Text { text: root.label; font-size: 12.5px; font-weight: 600; color: root.primary ? black : white; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Barrinhas de áudio do canto (animam quando toca).
component AudioBars inherits HorizontalLayout {
    in property <bool> playing;
    // Força de cada faixa do som (graves → agudos, 0 a 1). Vazio = só a animação (topo do notch aberto).
    in property <[float]> bands;
    in property <color> tint: white;
    // Altura onde as barrinhas ficam centradas.
    in property <length> box: 16px;
    property <duration> t: animation-tick();
    spacing: 2px;
    alignment: center;
    for i in (root.bands.length > 0 ? root.bands.length : 4) : Rectangle {
        width: 3px;
        height: root.bands.length > 0 ? 3px + 11px * min(1, root.bands[i])
            : root.playing ? 4px + 10px * abs(sin(root.t / 1ms * 0.4deg + i * 70deg)) : 4px;
        y: (root.box - self.height) / 2;
        border-radius: 1.5px;
        background: root.tint;
    }
}

export component Notch inherits Window {
    title: "Orbi";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // A janela muda de tamanho junto com o notch (o Rust ajusta): fora do notch não há janela,
    // então o clique passa direto para o que está embaixo.
    preferred-width: 660px;
    preferred-height: 300px;
    out property <length> big-width: 660px;
    out property <length> big-height: 300px;
    default-font-family: "Segoe UI";

    // Tamanhos do notch (o Rust usa os mesmos números para saber onde o clique vale).
    // Grande ou compacto (configurações), com as medidas do Orbi em C#.
    in property <bool> compact;
    out property <length> open-width: root.compact ? 544px : 620px;
    out property <length> open-height: root.compact ? 232px : 262px;
    in property <bool> has-media;
    // Borda onde o notch fica (0 = topo, 1 = esquerda, 2 = direita), como no Orbi em C#. Nas laterais
    // o notch fechado fica em pé: anel, barrinhas e a hora com as horas em cima dos minutos.
    in property <int> edge: 0;
    property <bool> side: root.edge != 0;
    in property <string> side-text;
    // Onde na borda (0 a 1: da esquerda para a direita no topo, de cima para baixo nas laterais). Só o Rust usa.
    in-out property <float> edge-pos: 0.5;
    // Modo jogo (botão no notch): fechado vira só um risquinho preto e só abre com o mouse 2 s em cima.
    in-out property <bool> game-mode;
    callback game-toggled();
    // Volume do Spotify (ou o geral, sem Spotify), 0 a 1, na página da música.
    in-out property <float> volume: 0.5;
    // Segurando a barra de volume: o Rust não sobrescreve com o valor do Windows enquanto você arrasta.
    in-out property <bool> volume-held;
    callback volume-changed(float);
    // Arrastando o notch pela borda: fica fechado enquanto anda.
    in property <bool> dragging;
    callback drag-start();
    callback drag-move();
    callback drag-end();
    // Como no Orbi em C#: barrinhas só enquanto toca; sem música o notch volta ao tamanho de só anel + hora.
    // Topo: 120 × 30, como no Orbi em C# (com ou sem música; as barrinhas cabem dentro).
    out property <length> closed-width: root.side ? (root.game-mode ? 6px : 34px) : root.game-mode ? 70px : 120px;
    // Visualizador (como o Wallpaper Engine): 4 faixas do som e o grave, que faz o notch fechado pulsar.
    in property <[float]> bands: [0, 0, 0, 0, 0];
    in property <float> level;
    // Batida (0 a 1): salta no bumbo e cai rápido.
    in property <float> pulse;
    out property <length> closed-height: root.game-mode ? (root.side ? 70px : 6px) : !root.side ? 30px : root.playing ? 116px : 92px;

    in-out property <bool> adding;
    // O Rust decide pela posição do mouse (não depende do aviso de "mouse em cima" da janela).
    in property <bool> hovered;
    // Pedido de permissão do Claude Code abre o notch sozinho (menos no modo jogo).
    out property <bool> open: !root.dragging && (root.hovered || ta.has-hover || root.adding || root.notes-focused || root.chat-focused || (root.perm-visible && !root.game-mode));
    callback quit();
    callback open-settings();
    in property <bool> gradient-enabled: true;
    in property <string> clock: "00:00";
    in property <string> closed-text: root.clock;
    in property <string> date-text;
    in property <float> battery: 1;
    in property <bool> charging;
    in property <bool> has-battery: true;

    // música
    in property <string> song: "Nada tocando";
    in property <string> artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <color> accent: #1A2A5C;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed: "0:00";
    in property <string> remaining: "-0:00";
    in property <bool> has-lyrics;
    // Letras ligadas (botões "Tocando | Letra" no topo da página da música; fica salvo).
    in-out property <bool> lyrics-on: true;
    callback lyrics-toggled();
    in property <string> lyric-prev;
    in property <string> lyric-now;
    in property <string> lyric-next;
    in property <string> lyric-next2;
    in property <float> look-x;
    in property <float> look-y;
    callback play-pause();
    callback next();
    callback previous();

    // páginas: 0 música, 1 tarefas, 2 foco
    // Páginas visíveis e em que ordem (configurações). pos = qual bolinha; page = qual página é.
    in property <[int]> order: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    in-out property <int> pos: 0;
    out property <int> page: root.order[min(root.pos, root.order.length - 1)];
    property <int> pages: root.order.length;
    property <[string]> titles: ["Tocando", "Tarefas", "Foco", "Calendário", "Notas", "Copiados", "Sistema", "Atalhos", "Agentes"];
    property <[string]> subtitles: ["agora", "hoje", "timer", "do mês", "rápidas", "recentes", "agora", "rápidos", "Claude Code"];

    in property <string> weather-glyph;
    in property <string> weather-text;

    // Chat com o Claude (ícone do Claude no topo; troca a página pela conversa).
    in-out property <bool> chat-open;
    in property <[ChatMsg]> chat-messages;
    in property <bool> chat-busy;
    in-out property <bool> chat-focused;
    callback chat-send(string);
    in property <string> chat-greeting;
    callback chat-opened();
    callback chat-clear();

    // Agentes do Claude Code (página 8): sessões, limites do plano e o pedido de permissão da vez.
    in property <[AgentRow]> agent-rows;
    in property <bool> agents-busy;
    in property <bool> agents-connected;
    in property <bool> perm-visible;
    in property <string> perm-project;
    in property <string> perm-what;
    in property <string> perm-code;
    in property <int> perm-count;
    callback perm-decide(string);
    in property <float> plan-five: -1;
    in property <string> plan-five-text;
    in property <float> plan-week: -1;
    in property <string> plan-week-text;

    // tarefas
    in property <[TaskRow]> tasks;
    in property <int> tasks-done;
    in property <int> tasks-total;
    callback toggle-task(int);
    callback add-task(string);
    callback clear-done();
    callback want-keyboard();

    // aviso rápido no notch fechado (carregador, bateria fraca, fone, lembrete)
    in property <bool> toasting;
    in property <string> toast-text;
    in property <string> toast-glyph;
    in property <color> toast-color: white;
    // Aviso de app: o ícone vai branco num quadradinho da cor do app.
    in property <bool> toast-badge;
    // Ícone de verdade do app (do menu Iniciar), quando o Windows entrega.
    in property <image> toast-icon;
    in property <bool> has-toast-icon;
    // App do aviso: WhatsApp, Discord, Gmail e Outlook têm o logo próprio (enviado pelo dono).
    in property <string> toast-app;
    property <bool> brand-icon: root.toast-app == "WhatsApp" || root.toast-app == "Discord" || root.toast-app == "Gmail" || root.toast-app == "Outlook";
    out property <length> toast-width: 360px;
    out property <length> toast-height: 36px;

    // calendário
    in property <string> month-name;
    in property <[DayCell]> days;
    callback month-prev();
    callback month-next();

    // notas (salvas sozinhas)
    in-out property <string> notes;
    in-out property <bool> notes-focused: false;
    callback notes-edited(string);

    // área de transferência
    in property <[string]> clips;
    in property <string> clip-hint: "Clique para copiar de novo";
    callback copy-clip(int);
    callback clear-clips();

    // sistema
    in property <float> cpu;
    in property <float> ram;
    in property <string> cpu-text: "—";
    in property <string> ram-text: "—";
    in property <string> ram-detail;
    in property <string> battery-detail;
    in property <string> audio-device: "Saída de áudio";

    // atalhos
    in property <[ShortcutItem]> shortcuts;
    callback open-shortcut(int);
    callback remove-shortcut(int);
    callback add-shortcut-file();
    callback add-shortcut-folder();
    callback add-shortcut-site(string);
    in-out property <bool> sc-adding;

    // foco
    in property <string> focus-text: "25:00";
    in property <bool> focus-running;
    in property <int> focus-minutes: 25;
    callback focus-toggle();
    callback focus-reset();
    callback focus-preset(int);


    // Bateria: verde (carregando ou acima de 50%), amarelo (21–50%), vermelho (20% ou menos).
    // Temperatura do PC em °C (-1 = o Windows não informa). Sem bateria, o anel do notch mostra ela.
    in property <float> temp: -1;
    property <color> temp-color: root.temp < 60 ? #30D158 : root.temp < 80 ? #FFD60A : #FF453A;
    property <bool> show-temp: !root.has-battery && root.temp >= 0;
    property <color> ring-color: !root.has-battery ? #8E8E93 : root.charging || root.battery > 0.5 ? #30D158 : root.battery > 0.2 ? #FFD60A : #FF453A;
    property <bool> music-glow: root.page == 0 && root.has-cover && root.gradient-enabled;

    property <length> pill-w: root.open ? root.open-width : root.toasting ? root.toast-width : root.closed-width;
    property <length> pill-h: root.open ? root.open-height : root.toasting ? root.toast-height : root.closed-height;
    // Abrir (notch ou aviso) com o "pulinho"; recolher direto, sem passar do ponto (como no Orbi em C#).
    animate pill-w, pill-h { duration: root.open || root.toasting ? 420ms : 300ms; easing: root.open || root.toasting ? ease-out-back : ease-out; }
    // Como no Orbi em C#: fechado, o notch inteiro (anel, barrinhas e hora juntos) cresce com o grave
    // e dá um tranco na batida; aberto fica parado para não atrapalhar os botões.
    property <float> beat-scale: root.open || root.game-mode ? 1 : 1 + 0.04 * root.level + 0.05 * root.pulse;
    pill := Rectangle {
        width: root.pill-w;
        height: root.pill-h;
        transform-scale: root.beat-scale;
        // Encostado na borda: cresce a partir dela; arredonda só os cantos do lado de dentro.
        transform-origin: root.edge == 1 ? { x: 0, y: self.height / 2 } : root.edge == 2 ? { x: self.width, y: self.height / 2 } : { x: self.width / 2, y: 0 };
        x: root.edge == 1 ? 0 : root.edge == 2 ? root.width - self.width : (root.width - self.width) / 2;
        y: root.side ? (root.height - self.height) / 2 : 0;
        property <length> r: root.open ? 30px : root.game-mode && !root.toasting ? 3px : root.side ? 16px : 28px;
        border-top-left-radius: root.edge == 2 ? self.r : 0;
        border-top-right-radius: root.edge == 1 ? self.r : 0;
        border-bottom-left-radius: root.edge != 1 ? self.r : 0;
        border-bottom-right-radius: root.edge != 2 ? self.r : 0;
        clip: true;
        // Fechado: preto. Música aberta: degradê do preto para a cor da capa (estilo Nusa).
        // Chat do Claude: o mesmo degradê da música, na cor do Claude (escurecida como as capas).
        background: root.open && root.chat-open && root.gradient-enabled ? @linear-gradient(180deg, #000000 0%, #000000 30%, #7A3E2C 100%)
            : root.open && root.music-glow && !root.chat-open ? @linear-gradient(180deg, #000000 0%, #000000 30%, root.accent 100%) : #000000;

        ta := TouchArea {
            // Segurar e arrastar o fundo do notch: ele corre pela borda e pula para a borda mais perto.
            pointer-event(e) => {
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) { root.drag-start(); }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) { root.drag-end(); }
            }
            moved => { if (self.pressed) { root.drag-move(); } }
            // Rodinha do mouse troca de página.
            scroll-event(e) => {
                if (e.delta-y < 0) { root.pos = Math.min(root.pos + 1, root.pages - 1); }
                else if (e.delta-y > 0) { root.pos = Math.max(root.pos - 1, 0); }
                accept
            }
        }

        // ---- fechado: anel da bateria + hora (ou o timer, quando corre) ----
        if root.side : VerticalLayout {
            opacity: root.open || root.toasting || root.game-mode ? 0 : 1;
            // Some na hora; volta só depois que o notch encolheu (senão aparece por baixo do aviso).
            animate opacity { duration: 150ms; delay: root.open || root.toasting ? 0ms : 200ms; }
            alignment: center;
            spacing: 6px;
            if root.has-battery : HorizontalLayout { alignment: center; Ring { value: root.battery; tint: root.ring-color; bolt: root.charging; } }
            if root.show-temp : HorizontalLayout { alignment: center; Ring { value: root.temp / 100; tint: root.temp-color; } }
            if root.playing : HorizontalLayout { alignment: center; AudioBars { playing: true; bands: root.bands; tint: #30D158; } }
            Text { text: root.side-text; color: root.focus-running ? #FF9F0A : white; font-size: 13px; font-weight: 600; horizontal-alignment: center; }
        }
        if !root.side : HorizontalLayout {
            opacity: root.open || root.toasting || root.game-mode ? 0 : 1;
            // Some na hora; volta só depois que o notch encolheu (senão aparece por baixo do aviso).
            animate opacity { duration: 150ms; delay: root.open || root.toasting ? 0ms : 200ms; }
            alignment: center;
            spacing: 0px; // os 6 px entre anel, barrinhas e hora ficam dentro da caixa das barrinhas
            // Anel de 18 px e hora centrados na mesma linha (medidas do Orbi em C#).
            padding-top: 6px;
            padding-bottom: 6px;
            // PC sem bateria (desktop): sem o anel, fica só a hora (e as barrinhas com música).
            if root.has-battery : Ring { size: 18px; value: root.battery; tint: root.ring-color; bolt: root.charging; }
            if root.show-temp : Ring { size: 18px; value: root.temp / 100; tint: root.temp-color; }
            // Barrinhas entram e saem encolhendo junto com o notch (antes sumiam de uma vez e o anel pulava).
            Rectangle {
                // 5 barrinhas de 3 px + 4 vãos de 2 px = 23 px, com 7 px de folga de cada lado.
                width: root.playing ? 23px + 14px : 6px;
                animate width { duration: 300ms; easing: ease-out; }
                clip: true;
                closed-bars := AudioBars { x: 7px; width: 23px; box: 18px; playing: true; bands: root.bands; tint: #30D158; opacity: root.playing ? 1 : 0; animate opacity { duration: 200ms; } }
            }
            Text { height: 18px; text: root.closed-text; color: root.focus-running ? #FF9F0A : white; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }

        // ---- aviso rápido ----
        HorizontalLayout {
            opacity: root.toasting && !root.open ? 1 : 0;
            // Aviso: aparece depois que o notch abriu; ao recolher, some primeiro (antes do notch encolher).
            animate opacity { duration: root.toasting ? 160ms : 90ms; delay: root.toasting ? 120ms : 0ms; }
            alignment: center;
            spacing: 8px;
            padding-left: 16px;
            padding-right: 16px;
            if !root.toast-badge : Text { text: root.toast-glyph; font-family: "Segoe MDL2 Assets"; font-size: 14px; color: root.toast-color; vertical-alignment: center; }
            if root.brand-icon : VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px; height: 22px;
                    if root.toast-app == "WhatsApp" : Image { source: @image-url("icons/whatsapp.png"); width: 22px; height: 22px; }
                    if root.toast-app == "Discord" : Image { source: @image-url("icons/discord.png"); width: 22px; height: 22px; }
                    if root.toast-app == "Gmail" : Image { source: @image-url("icons/gmail.png"); width: 22px; height: 22px; }
                    if root.toast-app == "Outlook" : Image { source: @image-url("icons/outlook.png"); width: 22px; height: 22px; }
                }
            }
            if root.has-toast-icon && !root.brand-icon : VerticalLayout {
                alignment: center;
                Image { source: root.toast-icon; width: 22px; height: 22px; image-fit: contain; }
            }
            if root.toast-badge && !root.has-toast-icon && !root.brand-icon : VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px; height: 22px; border-radius: 7px; background: root.toast-color;
                    Text { text: root.toast-glyph; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Text { text: root.toast-text; color: white; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        }

        // ---- aberto ----
        VerticalLayout {
            opacity: root.open ? 1 : 0;
            // Abre depois do notch crescer; ao fechar, some antes dele encolher.
            animate opacity { duration: root.open ? 220ms : 100ms; delay: root.open ? 90ms : 0ms; }
            padding-left: 46px; // espaço para as setas laterais
            padding-right: 46px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 6px;

            // Topo como no Nusa: título | bateria + data + hora | barrinhas
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                if root.chat-open : HorizontalLayout {
                    width: 150px;
                    spacing: 4px;
                    Text { text: "Claude"; color: #D97757; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                }
                if root.page != 0 && !root.chat-open : HorizontalLayout {
                    width: 150px;
                    spacing: 4px;
                    Text { text: root.titles[root.page]; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Text { text: root.subtitles[root.page]; color: #30D158; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                }
                // Música: dois botões no lugar do título — só o player ou o player com a letra ao lado.
                if root.page == 0 && !root.chat-open : HorizontalLayout {
                    width: 150px;
                    spacing: 10px;
                    alignment: start;
                    for opt[i] in ["Tocando", "Letra"] : Text {
                        text: opt;
                        font-size: 14px;
                        font-weight: 700;
                        color: (i == 1) == root.lyrics-on ? #30D158 : (lt.has-hover ? #AEAEB2 : #6E6E73);
                        vertical-alignment: center;
                        lt := TouchArea { mouse-cursor: pointer; clicked => { root.lyrics-on = i == 1; root.lyrics-toggled(); } }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    if root.has-battery : Ring { value: root.battery; tint: root.ring-color; bolt: root.charging; y: 4px; }
                    if root.show-temp : Ring { value: root.temp / 100; tint: root.temp-color; y: 4px; }
                    // Clima da cidade escolhida nas configurações.
                    if root.weather-text != "" : HorizontalLayout {
                        spacing: 4px;
                        Text { text: root.weather-glyph; font-family: "Segoe UI Symbol"; color: white; font-size: 13px; vertical-alignment: center; }
                        Text { text: root.weather-text; color: white; font-size: 12.5px; vertical-alignment: center; }
                    }
                    Text { text: root.date-text; color: white; font-size: 12.5px; vertical-alignment: center; }
                    Text { text: root.clock; color: white; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                }
                HorizontalLayout {
                    width: 150px;
                    alignment: end;
                    spacing: 6px;
                    // Barrinhas só com música tocando (parado eram só 4 pontinhos sem uso).
                    if root.playing : AudioBars { playing: true; }
                    // Na fonte de ícones a engrenagem desenha menor que o X: tamanhos diferentes para ficarem iguais na tela.
                    // Chat com o Claude: o asterisco laranja do Claude (como no coucou).
                    Rectangle {
                        width: 26px; height: 24px; border-radius: 12px;
                        background: root.chat-open ? #D9775733 : chat-ta.has-hover ? #FFFFFF18 : transparent;
                        ClaudeLogo { x: (parent.width - 15px) / 2; y: (parent.height - 15px) / 2; width: 15px; height: 15px; }
                        chat-ta := TouchArea { mouse-cursor: pointer; clicked => { root.chat-open = !root.chat-open; if (root.chat-open) { root.chat-opened(); } } }
                    }
                    // Modo jogo: verde quando ligado.
                    IconButton { glyph: "\u{E7FC}"; size: 14px; tint: root.game-mode ? #30D158 : #AEAEB2; width: 26px; height: 24px; clicked => { root.game-mode = !root.game-mode; root.game-toggled(); } }
                    IconButton { glyph: "\u{E713}"; size: 13px; tint: #AEAEB2; width: 26px; height: 24px; clicked => { root.open-settings(); } }
                    IconButton { glyph: "\u{E711}"; size: 11px; tint: #AEAEB2; width: 26px; height: 24px; clicked => { root.quit(); } }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // ---- página: música ----
                if root.page == 0 && !root.chat-open : HorizontalLayout {
                    spacing: 16px;
                    if !(root.lyrics-on && root.has-lyrics) : Avatar { width: root.compact ? 96px : 140px; look-x: root.look-x; look-y: root.look-y; pulse: root.playing ? root.level : 0; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        width: root.lyrics-on && root.has-lyrics ? 260px : root.compact ? 340px : 360px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 12px;
                                clip: true;
                                background: #222226;
                                if root.has-cover : Image { source: root.cover; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                if !root.has-cover : Text { text: "\u{E8D6}"; font-family: "Segoe MDL2 Assets"; font-size: 22px; color: #777777; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.song; color: white; font-size: 16px; font-weight: 700; overflow: elide; }
                                Text { text: root.artist; color: #FFFFFFAA; font-size: 13px; overflow: elide; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.elapsed; color: #FFFFFFCC; font-size: 11px; width: 36px; vertical-alignment: center; }
                            Rectangle {
                                height: 4px;
                                y: 7px;
                                border-radius: 2px;
                                background: #FFFFFF33;
                                Rectangle { x: 0; width: parent.width * clamp(root.progress, 0, 1); border-radius: 2px; background: white; }
                            }
                            Text { text: root.remaining; color: #FFFFFFCC; font-size: 11px; width: 40px; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            // Caixas iguais dos dois lados: os botões de tocar ficam no meio mesmo com o volume aberto.
                            HorizontalLayout {
                                width: root.lyrics-on && root.has-lyrics ? 60px : 100px;
                                alignment: end;
                                if root.has-lyrics : IconButton {
                                    glyph: "\u{E8BD}";
                                    size: 14px;
                                    tint: root.lyrics-on ? white : #FFFFFF88;
                                    clicked => { root.lyrics-on = !root.lyrics-on; root.lyrics-toggled(); }
                                }
                            }
                            IconButton { glyph: "\u{E892}"; clicked => { root.previous(); } }
                            IconButton { glyph: root.playing ? "\u{E769}" : "\u{E768}"; size: 19px; tint: white; clicked => { root.play-pause(); } }
                            IconButton { glyph: "\u{E893}"; clicked => { root.next(); } }
                            Rectangle {
                                // Com a letra ao lado a coluna é estreita: o volume aberto avança um pouco para a direita.
                                width: root.lyrics-on && root.has-lyrics ? 60px : 100px;
                                VolumeHover {
                                    x: 0;
                                    value <=> root.volume;
                                    held <=> root.volume-held;
                                    changed(v) => { root.volume-changed(v); }
                                }
                            }
                        }
                    }
                    // Letra: a linha cantada acesa, as outras apagadas.
                    if root.lyrics-on && root.has-lyrics : HorizontalLayout {
                        spacing: 16px;
                        Rectangle { width: 1px; background: #FFFFFF22; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text { text: root.lyric-prev; color: #FFFFFF55; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: root.lyric-now; color: white; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                            Text { text: root.lyric-next; color: #FFFFFF77; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: root.lyric-next2; color: #FFFFFF44; font-size: 13px; font-weight: 600; overflow: elide; }
                        }
                    }
                }

                // ---- página: tarefas (como o "4/5 Task Done Today" do Nusa) ----
                if root.page == 1 && !root.chat-open : HorizontalLayout {
                    spacing: 18px;
                    VerticalLayout {
                        width: 210px;
                        alignment: center;
                        spacing: 4px;
                        Text { text: root.tasks-done + "/" + root.tasks-total; color: white; font-size: 42px; font-weight: 800; }
                        Text { text: "feitas hoje"; color: #8E8E93; font-size: 13px; }
                        Rectangle { height: 8px; }
                        if !root.adding : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Pill { glyph: "\u{E710}"; label: "Adicionar"; clicked => { root.adding = true; root.want-keyboard(); input.focus(); } }
                            Pill { glyph: "\u{E74D}"; label: "Limpar"; clicked => { root.clear-done(); } }
                        }
                        input := LineEdit {
                            visible: root.adding;
                            height: root.adding ? 32px : 0px;
                            placeholder-text: "Nova tarefa… (Enter salva)";
                            accepted(text) => {
                                if (text != "") { root.add-task(text); }
                                self.text = "";
                                root.adding = false;
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) { self.text = ""; root.adding = false; return accept; }
                                reject
                            }
                        }
                    }
                    Flickable {
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            if root.tasks.length == 0 : Text { text: "Nenhuma tarefa. Clique em Adicionar."; color: #8E8E93; font-size: 13px; }
                            for task[i] in root.tasks : Rectangle {
                                height: 36px;
                                border-radius: 10px;
                                background: task.done ? #17331F : (row-ta.has-hover ? #26262B : #1C1C20);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        y: 8px;
                                        border-radius: 10px;
                                        background: task.done ? #30D158 : transparent;
                                        border-width: task.done ? 0px : 1.5px;
                                        border-color: #8E8E93;
                                        if task.done : Text { text: "\u{E73E}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: black; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: task.title; color: task.done ? #FFFFFF77 : white; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                    if task.due != "" : Text { text: task.due; color: #FF9F0A; font-size: 11px; vertical-alignment: center; }
                                }
                                row-ta := TouchArea { clicked => { root.toggle-task(i); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }

                // ---- página: foco ----
                if root.page == 2 && !root.chat-open : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text { text: root.focus-text; color: root.focus-running ? #FF9F0A : white; font-size: 56px; font-weight: 300; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Pill { primary: true; glyph: root.focus-running ? "\u{E769}" : "\u{E768}"; label: root.focus-running ? "Pausar" : "Iniciar"; clicked => { root.focus-toggle(); } }
                        Pill { glyph: "\u{E72C}"; label: "Zerar"; clicked => { root.focus-reset(); } }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for m in [5, 15, 25, 50] : Rectangle {
                            width: 44px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.focus-minutes == m ? #2C2C31 : transparent;
                            Text { text: m + "m"; color: root.focus-minutes == m ? white : #8E8E93; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.focus-preset(m); } mouse-cursor: pointer; }
                        }
                    }
                }

                // ---- página: calendário ----
                if root.page == 3 && !root.chat-open : VerticalLayout {
                    // Compacto: linhas mais baixas para as 6 semanas caberem acima das bolinhas.
                    spacing: root.compact ? 1px : 4px;
                    HorizontalLayout {
                        height: root.compact ? 22px : 26px;
                        Text { text: root.month-name; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                        IconButton { glyph: "\u{E76B}"; size: 11px; clicked => { root.month-prev(); } }
                        IconButton { glyph: "\u{E76C}"; size: 11px; clicked => { root.month-next(); } }
                    }
                    // Grade com posições calculadas (7 colunas de largura igual): com layouts, a largura de cada
                    // coluna dependia do texto e os números saíam tortos em relação às letras dos dias.
                    Rectangle {
                        property <length> cw: self.width / 7;
                        property <length> hh: root.compact ? 14px : 18px;
                        property <length> rh: root.compact ? 18px : 24px;
                        height: self.hh + 6 * self.rh;
                        for d[i] in ["D", "S", "T", "Q", "Q", "S", "S"] : Text {
                            x: i * parent.cw;
                            y: 0;
                            width: parent.cw;
                            height: parent.hh;
                            text: d;
                            color: #8E8E93;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        for c[i] in root.days : Rectangle {
                            x: mod(i, 7) * parent.cw;
                            y: parent.hh + floor(i / 7) * parent.rh;
                            width: parent.cw;
                            height: parent.rh;
                            // Hoje: pílula branca do tamanho do número, não da coluna inteira.
                            if c.today : Rectangle {
                                width: 32px;
                                height: parent.height - 4px;
                                border-radius: self.height / 2;
                                background: white;
                            }
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: c.day;
                                font-size: 12px;
                                font-weight: c.today ? 700 : 400;
                                color: c.today ? black : (c.in-month ? white : #48484A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ---- página: notas rápidas ----
                if root.page == 4 && !root.chat-open : Rectangle {
                    border-radius: 14px;
                    background: #141416;
                    notes-edit := TextEdit {
                        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                        text <=> root.notes;
                        font-size: 13px;
                        wrap: word-wrap;
                        placeholder-text: "Anote algo rápido… (salva sozinho)";
                        edited(text) => { root.notes-edited(text); }
                        // O notch fica aberto enquanto você digita.
                        changed has-focus => { root.notes-focused = self.has-focus; }
                    }
                }

                // ---- página: área de transferência ----
                if root.page == 5 && !root.chat-open : VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        height: 18px;
                        Text { text: root.clips.length == 0 ? "Copie um texto (Ctrl+C) e ele aparece aqui." : root.clip-hint; color: #8E8E93; font-size: 12px; }
                        if root.clips.length > 0 : Text {
                            text: "Limpar"; color: #8E8E93; font-size: 12px; horizontal-alignment: right;
                            TouchArea { clicked => { root.clear-clips(); } mouse-cursor: pointer; }
                        }
                    }
                    Flickable {
                        content-height: clip-list.preferred-height;
                        clip-list := VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for c[i] in root.clips : Rectangle {
                                height: 30px;
                                border-radius: 8px;
                                background: clip-ta.has-hover ? #26262B : #1C1C20;
                                Text { x: 10px; width: parent.width - 20px; text: c; color: white; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
                                clip-ta := TouchArea { clicked => { root.copy-clip(i); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }

                // ---- página: sistema ----
                if root.page == 6 && !root.chat-open : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: space-around;
                        Gauge { value: root.cpu; text: root.cpu-text; name: "CPU"; detail: "processador"; tint: root.cpu > 0.85 ? #FF453A : #30D158; }
                        Gauge { value: root.ram; text: root.ram-text; name: "Memória"; detail: root.ram-detail; tint: root.ram > 0.9 ? #FF453A : #0A84FF; }
                        // Bateria só em notebook; temperatura quando o Windows informa.
                        if root.has-battery : Gauge { value: root.battery; text: round(root.battery * 100) + "%"; name: "Bateria"; detail: root.battery-detail; tint: root.ring-color; }
                        if root.temp >= 0 : Gauge { value: root.temp / 100; text: round(root.temp) + "°"; name: "Temperatura"; detail: "do PC"; tint: root.temp-color; }
                    }
                    // Ícone do fone na fonte de ícones (na fonte de texto ele virava um quadradinho).
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "\u{E7F6}"; font-family: "Segoe MDL2 Assets"; color: #8E8E93; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.audio-device; color: #8E8E93; font-size: 11.5px; vertical-alignment: center; }
                    }
                }

                // ---- página: atalhos ----
                if root.page == 7 && !root.chat-open : Flickable {
                    content-height: grid.preferred-height;
                    grid := VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        // Adicionar: app/arquivo ou pasta (janela do Windows) ou site (digitado aqui).
                        if root.sc-adding : HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            Pill { glyph: "\u{E7AC}"; label: "App ou arquivo"; clicked => { root.add-shortcut-file(); } }
                            Pill { glyph: "\u{E8B7}"; label: "Pasta"; clicked => { root.add-shortcut-folder(); } }
                            site-edit := LineEdit {
                                placeholder-text: "site (ex.: youtube.com)";
                                horizontal-stretch: 1;
                                font-size: 12px;
                                init => { root.adding = true; root.want-keyboard(); }
                                accepted(text) => { root.add-shortcut-site(text); }
                            }
                            IconButton { glyph: "\u{E711}"; size: 11px; tint: #8E8E93; clicked => { root.sc-adding = false; root.adding = false; } }
                        }
                        for row in ceil(root.shortcuts.length / 6) : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for col in 6 : Rectangle {
                                property <int> k: row * 6 + col;
                                width: 74px;
                                height: 72px;
                                visible: self.k < root.shortcuts.length;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Rectangle {
                                        width: 42px; height: 42px; x: 16px;
                                        border-radius: 12px;
                                        background: sc-ta.has-hover ? #2C2C31 : #1E1E22;
                                        Text { text: root.shortcuts[k].glyph; font-family: "Segoe MDL2 Assets"; font-size: 18px; color: root.shortcuts[k].tint; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: root.shortcuts[k].name; color: #AEAEB2; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                }
                                // Clique abre; botão direito remove (só os seus atalhos).
                                sc-ta := TouchArea {
                                    clicked => { root.open-shortcut(k); }
                                    pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) { root.remove-shortcut(k); } }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }

                // ---- chat com o Claude (pela assinatura, via Claude Code) ----
                if root.chat-open : VerticalLayout {
                    spacing: 8px;
                    chat-flick := Flickable {
                        vertical-stretch: 1;
                        content-height: chat-list.preferred-height;
                        // Sempre mostra o fim da conversa.
                        content-y: min(0px, self.height - chat-list.preferred-height);
                        chat-list := VerticalLayout {
                            alignment: end;
                            spacing: 6px;
                            // Conversa vazia: como no Claude, o logo e uma frase diferente a cada vez que abre.
                            if root.chat-messages.length == 0 && !root.chat-busy : VerticalLayout {
                                spacing: 8px;
                                padding-bottom: 12px;
                                HorizontalLayout { alignment: center; ClaudeLogo { width: 28px; height: 28px; } }
                                Text { text: root.chat-greeting; color: white; font-size: 18px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                            }
                            for m in root.chat-messages : HorizontalLayout {
                                alignment: m.user ? end : start;
                                Rectangle {
                                    max-width: root.open-width * 0.62; // balão no máximo ~2/3 da largura
                                    border-radius: 12px;
                                    background: m.user ? #D97757 : #1C1C20;
                                    HorizontalLayout {
                                        padding: 8px;
                                        padding-left: 11px;
                                        padding-right: 11px;
                                        Text { text: m.text; color: white; font-size: 12.5px; wrap: word-wrap; }
                                    }
                                }
                            }
                            if root.chat-busy : Text { text: "Claude está pensando…"; color: #D97757; font-size: 12px; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        height: 32px;
                        chat-input := LineEdit {
                            placeholder-text: "Mensagem para o Claude";
                            font-size: 12.5px;
                            enabled: !root.chat-busy;
                            changed has-focus => { root.chat-focused = self.has-focus; if (self.has-focus) { root.want-keyboard(); } }
                            accepted(text) => { if (text != "") { root.chat-send(text); self.text = ""; } }
                        }
                        IconButton { glyph: "\u{E724}"; size: 13px; tint: #D97757; clicked => { if (chat-input.text != "" && !root.chat-busy) { root.chat-send(chat-input.text); chat-input.text = ""; } } }
                        IconButton { glyph: "\u{E74D}"; size: 12px; tint: #8E8E93; clicked => { root.chat-clear(); } }
                    }
                }

                // ---- página: agentes do Claude Code ----
                if root.page == 8 && !root.chat-open : VerticalLayout {
                    spacing: 8px;
                    if root.perm-visible : Rectangle {
                        border-radius: 14px;
                        background: #1C1C20;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "\u{E72E}"; font-family: "Segoe MDL2 Assets"; font-size: 14px; color: #FF9F0A; vertical-alignment: center; }
                                Text { text: root.perm-what; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                Text { text: root.perm-project + (root.perm-count > 1 ? "  ·  +" + (root.perm-count - 1) : ""); color: #8E8E93; font-size: 12px; vertical-alignment: center; }
                            }
                            Rectangle {
                                border-radius: 8px;
                                background: #0E0E10;
                                min-height: 44px;
                                Text { x: 10px; width: parent.width - 20px; text: root.perm-code; font-family: "Consolas"; font-size: 12px; color: #E5E5EA; wrap: word-wrap; overflow: elide; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Pill { glyph: "\u{E711}"; label: "Negar"; clicked => { root.perm-decide("deny"); } }
                                Pill { glyph: "\u{E8FB}"; label: "Sempre"; clicked => { root.perm-decide("always"); } }
                                Pill { glyph: "\u{E73E}"; label: "Permitir"; primary: true; clicked => { root.perm-decide("allow"); } }
                            }
                        }
                    }
                    if !root.perm-visible && root.agent-rows.length == 0 : VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        vertical-stretch: 1;
                        Text { text: root.agents-connected ? "Nenhuma sessão do Claude Code agora" : "Claude Code não está conectado"; color: white; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                        Text { text: root.agents-connected ? "Abra o Claude Code: as sessões, o que ele está fazendo e os pedidos de permissão aparecem aqui." : "Conecte em Configurações → Agentes."; color: #8E8E93; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    if !root.perm-visible && root.agent-rows.length > 0 : Flickable {
                        vertical-stretch: 1;
                        content-height: agent-list.preferred-height;
                        agent-list := VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            for a in root.agent-rows : Rectangle {
                                height: 32px;
                                border-radius: 8px;
                                background: #1C1C20;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Rectangle { width: 8px; height: 8px; y: 12px; border-radius: 4px; background: a.busy ? #0A84FF : #30D158; }
                                    Text { text: a.project; color: white; font-size: 12.5px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: a.status; color: #AEAEB2; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                    // Limites do plano (vêm da status line do Claude Code).
                    for w in [{ n: "5 horas", v: root.plan-five, t: root.plan-five-text }, { n: "Semana", v: root.plan-week, t: root.plan-week-text }] : HorizontalLayout {
                        visible: w.v >= 0;
                        height: w.v >= 0 ? 16px : 0px;
                        spacing: 10px;
                        Text { text: w.n; width: 56px; color: #AEAEB2; font-size: 11.5px; vertical-alignment: center; }
                        Rectangle {
                            Rectangle { y: 6px; height: 4px; border-radius: 2px; background: #FFFFFF22; }
                            Rectangle { x: 0; y: 6px; height: 4px; border-radius: 2px; width: parent.width * clamp(w.v, 0, 1); background: w.v > 0.85 ? #FF453A : w.v > 0.6 ? #FFD60A : #30D158; }
                        }
                        Text { text: w.t; width: 140px; color: #AEAEB2; font-size: 11.5px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }
            }

            // Bolinhas das páginas (clique para trocar). Somem no chat.
            if !root.chat-open : HorizontalLayout {
                height: 14px;
                alignment: center;
                spacing: 6px;
                for p in root.pages : Rectangle {
                    width: p == root.pos ? 18px : 6px;
                    height: 6px;
                    y: 4px;
                    border-radius: 3px;
                    background: p == root.pos ? white : #FFFFFF55;
                    animate width { duration: 200ms; }
                    TouchArea { clicked => { root.pos = p; } mouse-cursor: pointer; }
                }
            }
        }

        // Setas laterais (somem no chat).
        if root.open && !root.chat-open && root.pos > 0 : Rectangle {
            x: 8px; y: parent.height / 2 - 14px; width: 28px; height: 28px; border-radius: 14px; background: #FFFFFF18;
            Chevron { x: 6px; y: 6px; }
            TouchArea { clicked => { root.pos -= 1; } mouse-cursor: pointer; }
        }
        if root.open && !root.chat-open && root.pos < root.pages - 1 : Rectangle {
            x: parent.width - 36px; y: parent.height / 2 - 14px; width: 28px; height: 28px; border-radius: 14px; background: #FFFFFF18;
            Chevron { x: 6px; y: 6px; right: true; }
            TouchArea { clicked => { root.pos += 1; } mouse-cursor: pointer; }
        }
    }
}

// Configurações no visual do Orbi em C#: menu à esquerda, cartões com chave à direita.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();
    width: 50px;
    height: 28px;
    border-radius: 14px;
    background: root.checked ? #30D158 : #3A3A3E;
    animate background { duration: 150ms; }
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: white;
        x: root.checked ? root.width - self.width - 3px : 3px;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(); }
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    height: 30px;
    min-width: label.preferred-width + 28px;
    border-radius: 8px;
    background: root.primary ? (ta.has-hover ? #E5E5EA : white) : (ta.has-hover ? #38383C : #2A2A2E);
    label := Text { text: root.text; color: root.primary ? black : white; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: #6E6E73;
}

component Card inherits Rectangle {
    background: #161618;
    border-color: #232326;
    border-width: 1px;
    border-radius: 14px;
    VerticalLayout { @children }
}

component Divider inherits Rectangle {
    height: 1px;
    Rectangle { x: 18px; width: parent.width - 36px; height: 1px; background: #232326; }
}

// Linha do cartão: título + explicação à esquerda, controle (chave ou botões) à direita.
component Row inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.title; color: white; font-size: 14px; font-weight: 600; }
        if root.sub != "" : Text { text: root.sub; color: #8E8E93; font-size: 12px; wrap: word-wrap; }
    }
    HorizontalLayout { alignment: end; spacing: 8px; @children }
}

component SwitchRow inherits Row {
    in-out property <bool> checked;
    callback toggled();
    VerticalLayout { alignment: center; Toggle { checked <=> root.checked; toggled => { root.toggled(); } } }
}

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    border-radius: 8px;
    background: root.selected ? #1C1C1F : ta.has-hover ? #151517 : transparent;
    HorizontalLayout {
        padding-left: 12px;
        spacing: 12px;
        alignment: start;
        Text { text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: 13px; color: #8E8E93; vertical-alignment: center; }
        Text { text: root.text; font-size: 13.5px; color: white; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Settings inherits Window {
    title: "Orbi";
    icon: @image-url("../../orbi.png");
    preferred-width: 900px;
    preferred-height: 600px;
    min-width: 760px;
    min-height: 480px;
    background: #0B0B0C;
    default-font-family: "Segoe UI";
    in-out property <bool> start-with-windows;
    in-out property <bool> battery-alerts: true;
    in-out property <bool> audio-alerts: true;
    in-out property <bool> reminders: true;
    in-out property <bool> lyrics: true;
    in-out property <bool> gradient: true;
    in-out property <bool> auto-update: true;
    in-out property <bool> compact;
    in-out property <int> edge;
    in-out property <bool> app-notifications: true;
    in-out property <bool> sounds: true;
    in-out property <string> city;
    in-out property <string> api-key-input;
    in property <string> api-key-status;
    callback save-api-key(string);
    in property <string> city-status;
    callback save-city(string);
    in property <bool> agents-connected;
    in property <string> agents-status;
    callback agents-connect();
    callback agents-disconnect();
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-ready;
    callback changed();
    callback check-update();
    callback restart-update();
    callback open-folder();
    callback quit();
    // Páginas do notch: quais aparecem e em que ordem (cada bolinha é uma página).
    in property <[PageEntry]> page-list;
    callback page-toggle(int);
    callback page-move(int, int);

    property <int> section: 0;
    property <[{glyph: string, text: string}]> nav: [
        { glyph: "\u{E7F4}", text: "Notch" },
        { glyph: "\u{E8A9}", text: "Páginas" },
        { glyph: "\u{E790}", text: "Aparência" },
        { glyph: "\u{EA8F}", text: "Notificações" },
        { glyph: "\u{E706}", text: "Clima" },
        { glyph: "\u{E8D4}", text: "IA" },
        { glyph: "\u{E99A}", text: "Agentes" },
        { glyph: "\u{E895}", text: "Atualizações" },
        { glyph: "\u{E7E8}", text: "App" },
    ];
    // Clicar no menu rola até a seção (como no Orbi em C#).
    function go(i: int) {
        root.section = i;
        let y = i == 0 ? s0.y : i == 1 ? sp.y : i == 2 ? s1.y : i == 3 ? s2.y : i == 4 ? sw.y : i == 5 ? si.y : i == 6 ? sa.y : i == 7 ? s3.y : s4.y;
        flick.content-y = max(-(y - 8px), flick.height - flick.content-height);
    }

    HorizontalLayout {
        // ---- menu ----
        VerticalLayout {
            width: 230px;
            padding: 18px;
            padding-top: 22px;
            spacing: 2px;
            HorizontalLayout {
                spacing: 10px;
                height: 34px;
                Image { source: @image-url("../../orbi.png"); width: 28px; height: 28px; y: 3px; }
                Text { text: "Orbi"; font-size: 18px; font-weight: 700; color: white; vertical-alignment: center; }
            }
            Rectangle { height: 18px; }
            HorizontalLayout { padding-left: 10px; height: 22px; SectionLabel { text: "CONFIGURAÇÕES"; } }
            for item[i] in root.nav : NavItem {
                glyph: item.glyph;
                text: item.text;
                selected: root.section == i;
                clicked => { root.go(i); }
            }
            Rectangle { vertical-stretch: 1; }
            Rectangle {
                height: 36px;
                background: #141416;
                border-color: #232326;
                border-width: 1px;
                border-radius: 10px;
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 8px;
                    Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: #30D158; y: (parent.height - 7px) / 2; }
                    Text { text: "Ativo · mouse no notch"; font-size: 12px; color: #AEAEB2; vertical-alignment: center; }
                }
            }
        }

        // ---- conteúdo ----
        VerticalLayout {
            padding-top: 12px;
            padding-right: 12px;
            padding-bottom: 12px;
            Rectangle {
                background: #111113;
                border-color: #1E1E21;
                border-width: 1px;
                border-radius: 18px;
                clip: true;
                flick := Flickable {
                    content-height: content.preferred-height;
                    content := VerticalLayout {
                        width: flick.width;
                        padding: 26px;
                        padding-bottom: 30px;
                        spacing: 0px;
                        Rectangle {
                            height: 160px;
                            border-radius: 16px;
                            border-color: #26262A;
                            border-width: 1px;
                            clip: true;
                            background: @linear-gradient(135deg, #050506 0%, #0B0B0D 55%, #2C2C30 100%);
                            for st in [{x: 0.12, y: 0.70, s: 2px}, {x: 0.30, y: 0.25, s: 1.5px}, {x: 0.46, y: 0.62, s: 2px}, {x: 0.58, y: 0.18, s: 1.5px}, {x: 0.70, y: 0.48, s: 2.5px}, {x: 0.86, y: 0.22, s: 1.5px}, {x: 0.22, y: 0.40, s: 1px}] : Rectangle {
                                x: parent.width * st.x;
                                y: parent.height * st.y;
                                width: st.s;
                                height: st.s;
                                border-radius: st.s / 2;
                                background: #FFFFFF66;
                            }
                            Text { x: 26px; y: 34px; text: "Configurações"; font-size: 30px; font-weight: 700; color: white; }
                            Avatar { width: 96px; height: 96px; x: parent.width - self.width - 24px; y: parent.height - self.height - 6px; }
                        }

                        s0 := SectionLabel { text: "NOTCH"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            Row {
                                title: "Onde o notch fica";
                                sub: "Você também pode segurar o fundo do notch aberto e arrastar pela borda da tela.";
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 32px;
                                        width: eseg.preferred-width + 6px;
                                        border-radius: 8px;
                                        background: #1C1C1F;
                                        eseg := HorizontalLayout {
                                            x: 3px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            for opt[i] in ["Topo", "Esquerda", "Direita"] : Rectangle {
                                                width: et.preferred-width + 32px;
                                                border-radius: 6px;
                                                background: i == root.edge ? #3A3A3E : transparent;
                                                et := Text { text: opt; font-size: 13px; color: i == root.edge ? white : #C7C7CC; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { mouse-cursor: pointer; clicked => { root.edge = i; root.changed(); } }
                                            }
                                        }
                                    }
                                }
                            }
                            Divider { }
                            Row {
                                title: "Tamanho do notch aberto";
                                sub: "Grande deixa mais espaço para as listas, a letra e o calendário.";
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 32px;
                                        width: seg.preferred-width + 6px;
                                        border-radius: 8px;
                                        background: #1C1C1F;
                                        seg := HorizontalLayout {
                                            x: 3px;
                                            padding-top: 3px;
                                            padding-bottom: 3px;
                                            for opt[i] in ["Grande", "Compacto"] : Rectangle {
                                                width: t.preferred-width + 32px;
                                                border-radius: 6px;
                                                background: (i == 1) == root.compact ? #3A3A3E : transparent;
                                                t := Text { text: opt; font-size: 13px; color: (i == 1) == root.compact ? white : #C7C7CC; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { mouse-cursor: pointer; clicked => { root.compact = i == 1; root.changed(); } }
                                            }
                                        }
                                    }
                                }
                            }
                            Divider { }
                            SwitchRow {
                                title: "Iniciar com o Windows";
                                sub: "O notch aparece sozinho quando você liga o PC, sem abrir esta tela.";
                                checked <=> root.start-with-windows;
                                toggled => { root.changed(); }
                            }
                        }

                        sp := SectionLabel { text: "PÁGINAS DO NOTCH"; height: 46px; vertical-alignment: bottom; }
                        Text { text: "Escolha o que aparece e em que ordem: a primeira é a 1ª bolinha, a segunda é a 2ª…"; color: #8E8E93; font-size: 12px; wrap: word-wrap; }
                        Rectangle { height: 10px; }
                        Card {
                            for pg[i] in root.page-list : VerticalLayout {
                                if i > 0 : Divider { }
                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    padding-top: 9px;
                                    padding-bottom: 9px;
                                    spacing: 10px;
                                    Text { text: (i + 1) + "."; width: 22px; color: #6E6E73; font-size: 13px; vertical-alignment: center; }
                                    Text { text: pg.name; color: pg.visible ? white : #6E6E73; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                                    for dir in [-1, 1] : Rectangle {
                                        width: 30px;
                                        height: 28px;
                                        border-radius: 8px;
                                        property <bool> can: dir < 0 ? i > 0 : i < root.page-list.length - 1;
                                        background: self.can && mv.has-hover ? #38383C : #2A2A2E;
                                        opacity: self.can ? 1 : 0.35;
                                        Text { text: dir < 0 ? "\u{E70E}" : "\u{E70D}"; font-family: "Segoe MDL2 Assets"; font-size: 11px; color: white; horizontal-alignment: center; vertical-alignment: center; }
                                        mv := TouchArea { enabled: parent.can; mouse-cursor: pointer; clicked => { root.page-move(i, dir); } }
                                    }
                                    if pg.fixed : Text { text: "sempre"; width: 50px; color: #6E6E73; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    if !pg.fixed : VerticalLayout {
                                        alignment: center;
                                        Toggle { checked: pg.visible; toggled => { root.page-toggle(i); } }
                                    }
                                }
                            }
                        }

                        s1 := SectionLabel { text: "APARÊNCIA"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            SwitchRow {
                                title: "Gradiente com a cor da capa";
                                sub: "Na página da música, o fundo do notch pega a cor do álbum.";
                                checked <=> root.gradient;
                                toggled => { root.changed(); }
                            }
                            Divider { }
                            SwitchRow {
                                title: "Letras das músicas";
                                sub: "Mostra a letra sincronizada ao lado do player, quando a música tem.";
                                checked <=> root.lyrics;
                                toggled => { root.changed(); }
                            }
                        }

                        s2 := SectionLabel { text: "NOTIFICAÇÕES"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            SwitchRow {
                                title: "Bateria e carregador";
                                sub: "Avisa ao ligar ou tirar da tomada e quando a bateria fica fraca.";
                                checked <=> root.battery-alerts;
                                toggled => { root.changed(); }
                            }
                            Divider { }
                            SwitchRow {
                                title: "Saída de som";
                                sub: "Avisa quando o som muda para o fone ou para as caixas.";
                                checked <=> root.audio-alerts;
                                toggled => { root.changed(); }
                            }
                            Divider { }
                            SwitchRow {
                                title: "WhatsApp, Discord e email no notch";
                                sub: "Mostra as mensagens que chegam, lendo as notificações do próprio Windows. Nada sai do seu PC.";
                                checked <=> root.app-notifications;
                                toggled => { root.changed(); }
                            }
                            Divider { }
                            SwitchRow {
                                title: "Sons do Orbi";
                                sub: "Mensagens, lembretes e fim do foco. Para trocar, ponha .wav na pasta sons (aviso, lembrete, timer).";
                                checked <=> root.sounds;
                                toggled => { root.changed(); }
                            }
                            Divider { }
                            SwitchRow {
                                title: "Lembretes das tarefas";
                                sub: "Tarefas com hora (ex.: \"ligar pro banco às 15h\") avisam no notch.";
                                checked <=> root.reminders;
                                toggled => { root.changed(); }
                            }
                        }

                        sw := SectionLabel { text: "CLIMA"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            Row {
                                title: "Cidade";
                                sub: root.city-status;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        city-edit := LineEdit { width: 180px; text <=> root.city; placeholder-text: "ex.: Campinas"; accepted(t) => { root.save-city(t); } }
                                        PillButton { text: "Salvar"; clicked => { root.save-city(city-edit.text); } }
                                    }
                                }
                            }
                        }

                        si := SectionLabel { text: "INTELIGÊNCIA ARTIFICIAL"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            Row {
                                title: "Chave da API do Claude";
                                sub: root.api-key-status;
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        key-edit := LineEdit { width: 180px; input-type: password; text <=> root.api-key-input; placeholder-text: "sk-ant-..."; accepted(t) => { root.save-api-key(t); } }
                                        PillButton { text: "Salvar"; clicked => { root.save-api-key(key-edit.text); } }
                                        PillButton { text: "Remover"; clicked => { root.save-api-key(""); } }
                                    }
                                }
                            }
                        }

                        sa := SectionLabel { text: "AGENTES (CLAUDE CODE)"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            Row {
                                title: "Sessões, permissões e limites do plano no notch";
                                sub: root.agents-status;
                                if root.agents-connected : VerticalLayout { alignment: center; PillButton { text: "Desconectar"; clicked => { root.agents-disconnect(); } } }
                                if !root.agents-connected : VerticalLayout { alignment: center; PillButton { text: "Conectar"; primary: true; clicked => { root.agents-connect(); } } }
                            }
                        }

                        s3 := SectionLabel { text: "ATUALIZAÇÕES"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            SwitchRow {
                                title: "Atualizar sozinho";
                                sub: "Procura versão nova ao abrir e a cada 4 horas e baixa sozinho.";
                                checked <=> root.auto-update;
                                toggled => { root.changed(); }
                            }
                            Divider { }
                            Row {
                                title: "Orbi " + root.version;
                                sub: root.update-status;
                                VerticalLayout { alignment: center; PillButton { text: "Verificar agora"; clicked => { root.check-update(); } } }
                                if root.update-ready : VerticalLayout { alignment: center; PillButton { text: "Reiniciar e atualizar"; primary: true; clicked => { root.restart-update(); } } }
                            }
                        }

                        s4 := SectionLabel { text: "APP"; height: 46px; vertical-alignment: bottom; }
                        Rectangle { height: 10px; }
                        Card {
                            Row {
                                title: "Pasta dos dados";
                                sub: "Tarefas, notas e atalhos (atalhos.json) ficam aqui, os mesmos do Orbi em C#.";
                                VerticalLayout { alignment: center; PillButton { text: "Abrir pasta"; clicked => { root.open-folder(); } } }
                            }
                            Divider { }
                            Row {
                                title: "Fechar o Orbi";
                                sub: "O notch some até você abrir o app de novo. Fechar esta janela não fecha o notch.";
                                VerticalLayout { alignment: center; PillButton { text: "Sair"; clicked => { root.quit(); } } }
                            }
                        }
                    }
                }
            }
        }
    }
}
