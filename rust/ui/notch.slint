// Interface do notch do Orbi (Rust + Slint, sem HTML).
import { LineEdit, TextEdit } from "std-widgets.slint";

export struct TaskRow { title: string, done: bool, due: string }
export struct DayCell { day: int, in-month: bool, today: bool }
export struct ShortcutItem { name: string, glyph: string, tint: color }
export struct ChatMsg { user: bool, text: string }
export struct AgentRow { project: string, status: string, busy: bool }
export struct PageEntry { name: string, visible: bool, fixed: bool }

// Anel da bateria: trilho + arco no sentido horário a partir do topo.
component Ring inherits Rectangle {
    in property <length> size: 16px;
    in property <length> stroke: 2.5px;
    in property <float> value: 1;
    in property <color> tint: #30D158;
    in property <bool> bolt;
    width: root.size;
    height: root.size;
    // Arco no meio do traço; com o padrão (16 px, traço 2,5) dá exatamente o anel de antes.
    property <angle> a: clamp(root.value, 0, 1) * 360deg;
    Rectangle {
        border-radius: self.width / 2;
        border-width: root.stroke;
        border-color: #2E2E31;
    }
    if root.value >= 0.999 : Rectangle {
        border-radius: self.width / 2;
        border-width: root.stroke;
        border-color: root.tint;
    }
    // Arco = a mesma borda do trilho pintada só até o ângulo (fica sempre em cima do trilho, em qualquer escala).
    if root.value > 0.01 && root.value < 0.999 : Rectangle {
        border-radius: self.width / 2;
        border-width: root.stroke;
        border-color: @conic-gradient(root.tint 0deg, root.tint root.a, transparent root.a, transparent 360deg);
    }
    // Pontas arredondadas, como no Orbi em C#: uma bolinha no começo (topo) e outra no fim do arco.
    property <length> r: (root.size - root.stroke) / 2;
    if root.value > 0.01 && root.value < 0.999 : Rectangle {
        x: root.r; y: 0;
        width: root.stroke; height: root.stroke;
        border-radius: root.stroke / 2;
        background: root.tint;
    }
    if root.value > 0.01 && root.value < 0.999 : Rectangle {
        x: root.size / 2 + root.r * sin(root.a) - root.stroke / 2;
        y: root.size / 2 - root.r * cos(root.a) - root.stroke / 2;
        width: root.stroke; height: root.stroke;
        border-radius: root.stroke / 2;
        background: root.tint;
    }
    if root.bolt : Text {
        text: "\u{E945}";
        font-family: "Segoe MDL2 Assets";
        font-size: 7px;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Avatar do Orbi desenhado em vetor: corpo branco, olhos que piscam e seguem o mouse, sorriso.
component Avatar inherits Rectangle {
    in property <float> look-x;
    in property <float> look-y;
    in property <float> pulse;
    property <duration> t: animation-tick();
    // Pisca ~140 ms a cada 4,2 s.
    property <bool> blink: mod(root.t / 1ms, 4200) < 140;
    property <length> size: root.width * 0.82 * (1 + root.pulse * 0.1);
    body := Rectangle {
        width: root.size;
        height: root.size;
        x: (root.width - self.width) / 2 + root.look-x * 3px;
        // "Respira": sobe e desce devagar.
        y: (root.height - self.height) / 2 + sin(root.t / 1s * 70deg) * 2px - root.look-y * 2px;
        border-radius: self.width / 2;
        background: white;
        drop-shadow-blur: 28px;
        drop-shadow-color: #FFE2B855;
        for side in [-1, 1] : Rectangle {
            width: body.width * 0.12;
            height: root.blink ? 2px : body.width * 0.2;
            x: body.width / 2 + side * body.width * 0.17 - self.width / 2 + root.look-x * body.width * 0.07;
            y: body.height * 0.36 - root.look-y * body.height * 0.06 + (root.blink ? body.width * 0.09 : 0px);
            border-radius: self.width / 2;
            background: #111316;
        }
        Path {
            width: body.width * 0.2;
            height: body.height * 0.07;
            x: (body.width - self.width) / 2 + root.look-x * body.width * 0.05;
            y: body.height * 0.66 - root.look-y * body.height * 0.04;
            viewbox-width: 20;
            viewbox-height: 6;
            stroke: #111316;
            stroke-width: 2.5px;
            commands: "M 1 1 Q 10 7 19 1";
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 15px;
    in property <color> tint: #DDDDDD;
    callback clicked();
    width: 34px;
    height: 30px;
    border-radius: 15px;
    background: ta.has-hover ? #FFFFFF18 : transparent;
    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: root.size;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Medidor redondo da página Sistema (medidas do Orbi em C#: 74 px, traço 7, pontas redondas).
component Gauge inherits VerticalLayout {
    in property <float> value;
    in property <string> text;
    in property <string> name;
    in property <string> detail;
    in property <color> tint;
    spacing: 4px;
    alignment: center;
    Rectangle {
        width: 74px;
        height: 74px;
        Ring { width: 74px; height: 74px; size: 74px; stroke: 7px; value: root.value; tint: root.tint; }
        Text { text: root.text; color: white; font-size: 16px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
    Text { text: root.name; color: white; font-size: 12px; horizontal-alignment: center; }
    Text { text: root.detail; color: #8E8E93; font-size: 10.5px; horizontal-alignment: center; }
}

// Logo do Claude (vetor enviado pelo dono).
