// Interface do notch do Orbi (Rust + Slint, sem HTML).
import { LineEdit, TextEdit, Switch, Button } from "std-widgets.slint";

export struct TaskRow { title: string, done: bool, due: string }
export struct DayCell { day: int, in-month: bool, today: bool }
export struct ShortcutItem { name: string, glyph: string, tint: color }

// Anel da bateria: trilho + arco no sentido horário a partir do topo.
component Ring inherits Rectangle {
    in property <length> size: 16px;
    in property <length> stroke: 2.5px;
    in property <float> value: 1;
    in property <color> tint: #30D158;
    in property <bool> bolt;
    width: root.size;
    height: root.size;
    // Arco no meio do traço; com o padrão (16 px, traço 2,5) dá exatamente o anel de antes.
    property <float> sz: root.size / 1px;
    property <float> st: root.stroke / 1px;
    property <float> r: (root.sz - root.st) / 2;
    property <angle> a: clamp(root.value, 0, 1) * 360deg;
    Rectangle {
        border-radius: self.width / 2;
        border-width: root.stroke;
        border-color: #2E2E31;
    }
    if root.value >= 0.999 : Rectangle {
        border-radius: self.width / 2;
        border-width: root.stroke;
        border-color: root.tint;
    }
    if root.value > 0.01 && root.value < 0.999 : Path {
        width: root.size;
        height: root.size;
        viewbox-width: root.sz;
        viewbox-height: root.sz;
        stroke: root.tint;
        stroke-width: root.stroke;
        commands: "M " + (root.sz / 2) + " " + (root.st / 2) + " A " + root.r + " " + root.r + " 0 " + (root.value > 0.5 ? "1" : "0") + " 1 "
            + (root.sz / 2 + root.r * sin(root.a)) + " " + (root.sz / 2 - root.r * cos(root.a));
    }
    if root.bolt : Text {
        text: "\u{E945}";
        font-family: "Segoe MDL2 Assets";
        font-size: 7px;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Avatar do Orbi desenhado em vetor: corpo branco, olhos que piscam e seguem o mouse, sorriso.
component Avatar inherits Rectangle {
    in property <float> look-x;
    in property <float> look-y;
    in property <float> pulse;
    property <duration> t: animation-tick();
    // Pisca ~140 ms a cada 4,2 s.
    property <bool> blink: mod(root.t / 1ms, 4200) < 140;
    property <length> size: root.width * 0.82 * (1 + root.pulse * 0.1);
    body := Rectangle {
        width: root.size;
        height: root.size;
        x: (root.width - self.width) / 2 + root.look-x * 3px;
        // "Respira": sobe e desce devagar.
        y: (root.height - self.height) / 2 + sin(root.t / 1s * 70deg) * 2px - root.look-y * 2px;
        border-radius: self.width / 2;
        background: white;
        drop-shadow-blur: 28px;
        drop-shadow-color: #FFE2B855;
        for side in [-1, 1] : Rectangle {
            width: body.width * 0.12;
            height: root.blink ? 2px : body.width * 0.2;
            x: body.width / 2 + side * body.width * 0.17 - self.width / 2 + root.look-x * body.width * 0.07;
            y: body.height * 0.36 - root.look-y * body.height * 0.06 + (root.blink ? body.width * 0.09 : 0px);
            border-radius: self.width / 2;
            background: #111316;
        }
        Path {
            width: body.width * 0.2;
            height: body.height * 0.07;
            x: (body.width - self.width) / 2 + root.look-x * body.width * 0.05;
            y: body.height * 0.66 - root.look-y * body.height * 0.04;
            viewbox-width: 20;
            viewbox-height: 6;
            stroke: #111316;
            stroke-width: 2.5px;
            commands: "M 1 1 Q 10 7 19 1";
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 15px;
    in property <color> tint: #DDDDDD;
    callback clicked();
    width: 34px;
    height: 30px;
    border-radius: 15px;
    background: ta.has-hover ? #FFFFFF18 : transparent;
    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: root.size;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Botão em pílula (estilo Nusa): ícone + texto.
component Pill inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> primary;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    background: root.primary ? (ta.has-hover ? #E6E6E6 : white) : (ta.has-hover ? #2C2C31 : #1E1E22);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        if root.glyph != "" : Text { text: root.glyph; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: root.primary ? black : white; vertical-alignment: center; }
        Text { text: root.label; font-size: 12.5px; font-weight: 600; color: root.primary ? black : white; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// Barrinhas de áudio do canto (animam quando toca).
component AudioBars inherits HorizontalLayout {
    in property <bool> playing;
    property <duration> t: animation-tick();
    spacing: 2px;
    alignment: center;
    for i in [0, 1, 2, 3] : Rectangle {
        width: 3px;
        height: root.playing ? 4px + 10px * abs(sin(root.t / 1ms * 0.4deg + i * 70deg)) : 4px;
        y: (16px - self.height) / 2;
        border-radius: 1.5px;
        background: white;
    }
}

export component Notch inherits Window {
    title: "Orbi";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    // A janela muda de tamanho junto com o notch (o Rust ajusta): fora do notch não há janela,
    // então o clique passa direto para o que está embaixo.
    preferred-width: 660px;
    preferred-height: 300px;
    out property <length> big-width: 660px;
    out property <length> big-height: 300px;
    default-font-family: "Segoe UI";

    // Tamanhos do notch (o Rust usa os mesmos números para saber onde o clique vale).
    out property <length> open-width: 620px;
    out property <length> open-height: 262px;
    out property <length> closed-width: 132px;
    out property <length> closed-height: 32px;

    in-out property <bool> adding;
    // O Rust decide pela posição do mouse (não depende do aviso de "mouse em cima" da janela).
    in property <bool> hovered;
    out property <bool> open: root.hovered || ta.has-hover || root.adding || root.notes-focused;
    callback quit();
    callback open-settings();
    in property <bool> gradient-enabled: true;
    in property <string> clock: "00:00";
    in property <string> closed-text: root.clock;
    in property <string> date-text;
    in property <float> battery: 1;
    in property <bool> charging;
    in property <bool> has-battery: true;

    // música
    in property <string> song: "Nada tocando";
    in property <string> artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <color> accent: #1A2A5C;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed: "0:00";
    in property <string> remaining: "-0:00";
    in property <bool> has-lyrics;
    in-out property <bool> show-lyrics: true;
    in property <string> lyric-prev;
    in property <string> lyric-now;
    in property <string> lyric-next;
    in property <string> lyric-next2;
    in property <float> look-x;
    in property <float> look-y;
    callback play-pause();
    callback next();
    callback previous();

    // páginas: 0 música, 1 tarefas, 2 foco
    in-out property <int> page: 0;
    property <int> pages: 8;
    property <[string]> titles: ["Tocando", "Tarefas", "Foco", "Calendário", "Notas", "Copiados", "Sistema", "Atalhos"];
    property <[string]> subtitles: ["agora", "hoje", "timer", "do mês", "rápidas", "recentes", "agora", "rápidos"];

    // tarefas
    in property <[TaskRow]> tasks;
    in property <int> tasks-done;
    in property <int> tasks-total;
    callback toggle-task(int);
    callback add-task(string);
    callback clear-done();
    callback want-keyboard();

    // aviso rápido no notch fechado (carregador, bateria fraca, fone, lembrete)
    in property <bool> toasting;
    in property <string> toast-text;
    in property <string> toast-glyph;
    in property <color> toast-color: white;
    out property <length> toast-width: 360px;
    out property <length> toast-height: 36px;

    // calendário
    in property <string> month-name;
    in property <[DayCell]> days;
    callback month-prev();
    callback month-next();

    // notas (salvas sozinhas)
    in-out property <string> notes;
    in-out property <bool> notes-focused: false;
    callback notes-edited(string);

    // área de transferência
    in property <[string]> clips;
    in property <string> clip-hint: "Clique para copiar de novo";
    callback copy-clip(int);
    callback clear-clips();

    // sistema
    in property <float> cpu;
    in property <float> ram;
    in property <string> cpu-text: "—";
    in property <string> ram-text: "—";
    in property <string> ram-detail;
    in property <string> battery-detail;
    in property <string> audio-device: "Saída de áudio";

    // atalhos
    in property <[ShortcutItem]> shortcuts;
    callback open-shortcut(int);

    // foco
    in property <string> focus-text: "25:00";
    in property <bool> focus-running;
    in property <int> focus-minutes: 25;
    callback focus-toggle();
    callback focus-reset();
    callback focus-preset(int);


    property <color> ring-color: !root.has-battery ? #8E8E93 : (root.battery <= 0.2 && !root.charging ? #FF453A : #30D158);
    property <bool> music-glow: root.page == 0 && root.has-cover && root.gradient-enabled;

    pill := Rectangle {
        width: root.open ? root.open-width : root.toasting ? root.toast-width : root.closed-width;
        height: root.open ? root.open-height : root.toasting ? root.toast-height : root.closed-height;
        x: (root.width - self.width) / 2;
        y: 0;
        animate width, height { duration: 420ms; easing: ease-out-back; }
        border-bottom-left-radius: root.open ? 30px : 16px;
        border-bottom-right-radius: root.open ? 30px : 16px;
        animate border-bottom-left-radius, border-bottom-right-radius { duration: 300ms; }
        clip: true;
        // Fechado: preto. Música aberta: degradê do preto para a cor da capa (estilo Nusa).
        background: root.open && root.music-glow ? @linear-gradient(180deg, #000000 0%, #000000 30%, root.accent 100%) : #000000;

        ta := TouchArea {
            // Rodinha do mouse troca de página.
            scroll-event(e) => {
                if (e.delta-y < 0) { root.page = Math.min(root.page + 1, root.pages - 1); }
                else if (e.delta-y > 0) { root.page = Math.max(root.page - 1, 0); }
                accept
            }
        }

        // ---- fechado: anel da bateria + hora (ou o timer, quando corre) ----
        HorizontalLayout {
            opacity: root.open || root.toasting ? 0 : 1;
            animate opacity { duration: 150ms; }
            alignment: center;
            spacing: 6px;
            padding-top: 8px;
            padding-bottom: 8px;
            Ring { value: root.battery; tint: root.ring-color; bolt: root.charging; }
            Text { text: root.closed-text; color: root.focus-running ? #FF9F0A : white; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }

        // ---- aviso rápido ----
        HorizontalLayout {
            opacity: root.toasting && !root.open ? 1 : 0;
            animate opacity { duration: 160ms; delay: 120ms; }
            alignment: center;
            spacing: 8px;
            padding-left: 16px;
            padding-right: 16px;
            Text { text: root.toast-glyph; font-family: "Segoe MDL2 Assets"; font-size: 14px; color: root.toast-color; vertical-alignment: center; }
            Text { text: root.toast-text; color: white; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
        }

        // ---- aberto ----
        VerticalLayout {
            opacity: root.open ? 1 : 0;
            animate opacity { duration: 220ms; delay: 90ms; }
            padding-left: 46px; // espaço para as setas laterais
            padding-right: 46px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 6px;

            // Topo como no Nusa: título | bateria + data + hora | barrinhas
            HorizontalLayout {
                height: 24px;
                spacing: 8px;
                HorizontalLayout {
                    width: 150px;
                    spacing: 4px;
                    Text { text: root.titles[root.page]; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Text { text: root.subtitles[root.page]; color: #30D158; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Ring { value: root.battery; tint: root.ring-color; bolt: root.charging; y: 4px; }
                    Text { text: root.date-text; color: white; font-size: 12.5px; vertical-alignment: center; }
                    Text { text: root.clock; color: white; font-size: 12.5px; font-weight: 700; vertical-alignment: center; }
                }
                HorizontalLayout {
                    width: 150px;
                    alignment: end;
                    spacing: 6px;
                    AudioBars { playing: root.playing; }
                    IconButton { glyph: "\u{E713}"; size: 10px; tint: #8E8E93; width: 24px; height: 24px; clicked => { root.open-settings(); } }
                    IconButton { glyph: "\u{E711}"; size: 10px; tint: #8E8E93; width: 24px; height: 24px; clicked => { root.quit(); } }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                // ---- página: música ----
                if root.page == 0 : HorizontalLayout {
                    spacing: 16px;
                    if !(root.show-lyrics && root.has-lyrics) : Avatar { width: 140px; look-x: root.look-x; look-y: root.look-y; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        width: root.show-lyrics && root.has-lyrics ? 260px : 360px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 12px;
                                clip: true;
                                background: #222226;
                                if root.has-cover : Image { source: root.cover; width: parent.width; height: parent.height; image-fit: ImageFit.cover; }
                                if !root.has-cover : Text { text: "\u{E8D6}"; font-family: "Segoe MDL2 Assets"; font-size: 22px; color: #777777; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text { text: root.song; color: white; font-size: 16px; font-weight: 700; overflow: elide; }
                                Text { text: root.artist; color: #FFFFFFAA; font-size: 13px; overflow: elide; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.elapsed; color: #FFFFFFCC; font-size: 11px; width: 36px; vertical-alignment: center; }
                            Rectangle {
                                height: 4px;
                                y: 7px;
                                border-radius: 2px;
                                background: #FFFFFF33;
                                Rectangle { x: 0; width: parent.width * clamp(root.progress, 0, 1); border-radius: 2px; background: white; }
                            }
                            Text { text: root.remaining; color: #FFFFFFCC; font-size: 11px; width: 40px; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            if root.has-lyrics : IconButton {
                                glyph: "\u{E8BD}";
                                size: 14px;
                                tint: root.show-lyrics ? white : #FFFFFF88;
                                clicked => { root.show-lyrics = !root.show-lyrics; }
                            }
                            IconButton { glyph: "\u{E892}"; clicked => { root.previous(); } }
                            IconButton { glyph: root.playing ? "\u{E769}" : "\u{E768}"; size: 19px; tint: white; clicked => { root.play-pause(); } }
                            IconButton { glyph: "\u{E893}"; clicked => { root.next(); } }
                        }
                    }
                    // Letra: a linha cantada acesa, as outras apagadas.
                    if root.show-lyrics && root.has-lyrics : HorizontalLayout {
                        spacing: 16px;
                        Rectangle { width: 1px; background: #FFFFFF22; }
                        VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text { text: root.lyric-prev; color: #FFFFFF55; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: root.lyric-now; color: white; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                            Text { text: root.lyric-next; color: #FFFFFF77; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: root.lyric-next2; color: #FFFFFF44; font-size: 13px; font-weight: 600; overflow: elide; }
                        }
                    }
                }

                // ---- página: tarefas (como o "4/5 Task Done Today" do Nusa) ----
                if root.page == 1 : HorizontalLayout {
                    spacing: 18px;
                    VerticalLayout {
                        width: 210px;
                        alignment: center;
                        spacing: 4px;
                        Text { text: root.tasks-done + "/" + root.tasks-total; color: white; font-size: 42px; font-weight: 800; }
                        Text { text: "feitas hoje"; color: #8E8E93; font-size: 13px; }
                        Rectangle { height: 8px; }
                        if !root.adding : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Pill { glyph: "\u{E710}"; label: "Adicionar"; clicked => { root.adding = true; root.want-keyboard(); input.focus(); } }
                            Pill { glyph: "\u{E74D}"; label: "Limpar"; clicked => { root.clear-done(); } }
                        }
                        input := LineEdit {
                            visible: root.adding;
                            height: root.adding ? 32px : 0px;
                            placeholder-text: "Nova tarefa… (Enter salva)";
                            accepted(text) => {
                                if (text != "") { root.add-task(text); }
                                self.text = "";
                                root.adding = false;
                            }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) { self.text = ""; root.adding = false; return accept; }
                                reject
                            }
                        }
                    }
                    Flickable {
                        content-height: list.preferred-height;
                        list := VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            if root.tasks.length == 0 : Text { text: "Nenhuma tarefa. Clique em Adicionar."; color: #8E8E93; font-size: 13px; }
                            for task[i] in root.tasks : Rectangle {
                                height: 36px;
                                border-radius: 10px;
                                background: task.done ? #17331F : (row-ta.has-hover ? #26262B : #1C1C20);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        y: 8px;
                                        border-radius: 10px;
                                        background: task.done ? #30D158 : transparent;
                                        border-width: task.done ? 0px : 1.5px;
                                        border-color: #8E8E93;
                                        if task.done : Text { text: "\u{E73E}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: black; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: task.title; color: task.done ? #FFFFFF77 : white; font-size: 13px; vertical-alignment: center; overflow: elide; }
                                    if task.due != "" : Text { text: task.due; color: #FF9F0A; font-size: 11px; vertical-alignment: center; }
                                }
                                row-ta := TouchArea { clicked => { root.toggle-task(i); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }

                // ---- página: foco ----
                if root.page == 2 : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text { text: root.focus-text; color: root.focus-running ? #FF9F0A : white; font-size: 56px; font-weight: 300; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Pill { primary: true; glyph: root.focus-running ? "\u{E769}" : "\u{E768}"; label: root.focus-running ? "Pausar" : "Iniciar"; clicked => { root.focus-toggle(); } }
                        Pill { glyph: "\u{E72C}"; label: "Zerar"; clicked => { root.focus-reset(); } }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for m in [5, 15, 25, 50] : Rectangle {
                            width: 44px;
                            height: 24px;
                            border-radius: 12px;
                            background: root.focus-minutes == m ? #2C2C31 : transparent;
                            Text { text: m + "m"; color: root.focus-minutes == m ? white : #8E8E93; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.focus-preset(m); } mouse-cursor: pointer; }
                        }
                    }
                }

                // ---- página: calendário ----
                if root.page == 3 : VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        height: 26px;
                        Text { text: root.month-name; color: white; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                        IconButton { glyph: "\u{E76B}"; size: 11px; clicked => { root.month-prev(); } }
                        IconButton { glyph: "\u{E76C}"; size: 11px; clicked => { root.month-next(); } }
                    }
                    HorizontalLayout {
                        for d in ["D", "S", "T", "Q", "Q", "S", "S"] : Text { text: d; color: #8E8E93; font-size: 11px; horizontal-alignment: center; }
                    }
                    for row in 6 : HorizontalLayout {
                        for col in 7 : Rectangle {
                            property <DayCell> cell: root.days[row * 7 + col];
                            height: 21px;
                            border-radius: 6px;
                            background: self.cell.today ? white : transparent;
                            Text {
                                text: parent.cell.day;
                                font-size: 12px;
                                font-weight: parent.cell.today ? 700 : 400;
                                color: parent.cell.today ? black : (parent.cell.in-month ? white : #48484A);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // ---- página: notas rápidas ----
                if root.page == 4 : Rectangle {
                    border-radius: 14px;
                    background: #141416;
                    notes-edit := TextEdit {
                        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                        text <=> root.notes;
                        font-size: 13px;
                        wrap: word-wrap;
                        placeholder-text: "Anote algo rápido… (salva sozinho)";
                        edited(text) => { root.notes-edited(text); }
                        // O notch fica aberto enquanto você digita.
                        changed has-focus => { root.notes-focused = self.has-focus; }
                    }
                }

                // ---- página: área de transferência ----
                if root.page == 5 : VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        height: 18px;
                        Text { text: root.clips.length == 0 ? "Copie um texto (Ctrl+C) e ele aparece aqui." : root.clip-hint; color: #8E8E93; font-size: 12px; }
                        if root.clips.length > 0 : Text {
                            text: "Limpar"; color: #8E8E93; font-size: 12px; horizontal-alignment: right;
                            TouchArea { clicked => { root.clear-clips(); } mouse-cursor: pointer; }
                        }
                    }
                    Flickable {
                        content-height: clip-list.preferred-height;
                        clip-list := VerticalLayout {
                            spacing: 4px;
                            alignment: start;
                            for c[i] in root.clips : Rectangle {
                                height: 30px;
                                border-radius: 8px;
                                background: clip-ta.has-hover ? #26262B : #1C1C20;
                                Text { x: 10px; width: parent.width - 20px; text: c; color: white; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
                                clip-ta := TouchArea { clicked => { root.copy-clip(i); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }

                // ---- página: sistema ----
                if root.page == 6 : VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: space-around;
                        for g in [
                            { v: root.cpu, t: root.cpu-text, n: "CPU", d: "processador", c: root.cpu > 0.85 ? #FF453A : #30D158 },
                            { v: root.ram, t: root.ram-text, n: "Memória", d: root.ram-detail, c: root.ram > 0.9 ? #FF453A : #0A84FF },
                            { v: root.has-battery ? root.battery : 0, t: root.has-battery ? round(root.battery * 100) + "%" : "—", n: "Bateria", d: root.battery-detail, c: root.ring-color },
                        ] : VerticalLayout {
                            spacing: 4px;
                            alignment: center;
                            Rectangle {
                                width: 84px;
                                height: 84px;
                                Ring { width: 84px; height: 84px; size: 84px; stroke: 8px; value: g.v; tint: g.c; }
                                Text { text: g.t; color: white; font-size: 17px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: g.n; color: white; font-size: 12.5px; horizontal-alignment: center; }
                            Text { text: g.d; color: #8E8E93; font-size: 11px; horizontal-alignment: center; }
                        }
                    }
                    Text { text: "\u{E7F6}  " + root.audio-device; font-family: "Segoe UI"; color: #8E8E93; font-size: 11.5px; horizontal-alignment: center; }
                }

                // ---- página: atalhos ----
                if root.page == 7 : Flickable {
                    content-height: grid.preferred-height;
                    grid := VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        for row in ceil(root.shortcuts.length / 6) : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            for col in 6 : Rectangle {
                                property <int> k: row * 6 + col;
                                width: 74px;
                                height: 72px;
                                visible: self.k < root.shortcuts.length;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    Rectangle {
                                        width: 42px; height: 42px; x: 16px;
                                        border-radius: 12px;
                                        background: sc-ta.has-hover ? #2C2C31 : #1E1E22;
                                        Text { text: root.shortcuts[k].glyph; font-family: "Segoe MDL2 Assets"; font-size: 18px; color: root.shortcuts[k].tint; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    Text { text: root.shortcuts[k].name; color: #AEAEB2; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                }
                                sc-ta := TouchArea { clicked => { root.open-shortcut(k); } mouse-cursor: pointer; }
                            }
                        }
                    }
                }
            }

            // Bolinhas das páginas (clique para trocar).
            HorizontalLayout {
                height: 14px;
                alignment: center;
                spacing: 6px;
                for p in root.pages : Rectangle {
                    width: p == root.page ? 18px : 6px;
                    height: 6px;
                    y: 4px;
                    border-radius: 3px;
                    background: p == root.page ? white : #FFFFFF55;
                    animate width { duration: 200ms; }
                    TouchArea { clicked => { root.page = p; } mouse-cursor: pointer; }
                }
            }
        }

        // Setas laterais.
        if root.open && root.page > 0 : Rectangle {
            x: 8px; y: parent.height / 2 - 14px; width: 28px; height: 28px; border-radius: 14px; background: #FFFFFF18;
            Text { text: "\u{E76B}"; font-family: "Segoe MDL2 Assets"; font-size: 11px; color: white; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.page -= 1; } mouse-cursor: pointer; }
        }
        if root.open && root.page < root.pages - 1 : Rectangle {
            x: parent.width - 36px; y: parent.height / 2 - 14px; width: 28px; height: 28px; border-radius: 14px; background: #FFFFFF18;
            Text { text: "\u{E76C}"; font-family: "Segoe MDL2 Assets"; font-size: 11px; color: white; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.page += 1; } mouse-cursor: pointer; }
        }
    }
}

// Configurações (janela comum do Windows, abre pela engrenagem do notch).
export component Settings inherits Window {
    title: "Configurações do Orbi";
    icon: @image-url("../../orbi.png");
    preferred-width: 420px;
    preferred-height: 560px;
    background: #1C1C1E;
    in-out property <bool> start-with-windows;
    in-out property <bool> battery-alerts: true;
    in-out property <bool> audio-alerts: true;
    in-out property <bool> reminders: true;
    in-out property <bool> lyrics: true;
    in-out property <bool> gradient: true;
    in-out property <bool> auto-update: true;
    in property <string> version;
    in property <string> update-status;
    in property <bool> update-ready;
    callback changed();
    callback check-update();
    callback restart-update();
    callback open-folder();

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text { text: "Configurações"; font-size: 22px; font-weight: 700; color: white; }
        Text { text: "Geral"; font-size: 13px; font-weight: 600; color: #30D158; }
        Switch { text: "Iniciar com o Windows"; checked <=> root.start-with-windows; toggled => { root.changed(); } }
        Switch { text: "Letras das músicas"; checked <=> root.lyrics; toggled => { root.changed(); } }
        Switch { text: "Gradiente com a cor da capa"; checked <=> root.gradient; toggled => { root.changed(); } }
        Text { text: "Avisos"; font-size: 13px; font-weight: 600; color: #30D158; }
        Switch { text: "Bateria e carregador"; checked <=> root.battery-alerts; toggled => { root.changed(); } }
        Switch { text: "Troca da saída de som (fone)"; checked <=> root.audio-alerts; toggled => { root.changed(); } }
        Switch { text: "Lembretes das tarefas"; checked <=> root.reminders; toggled => { root.changed(); } }
        Text { text: "Atualização"; font-size: 13px; font-weight: 600; color: #30D158; }
        Switch { text: "Atualizar sozinho"; checked <=> root.auto-update; toggled => { root.changed(); } }
        Text { text: root.update-status; color: #AEAEB2; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Procurar agora"; clicked => { root.check-update(); } }
            Button { text: "Reiniciar e atualizar"; primary: true; enabled: root.update-ready; clicked => { root.restart-update(); } }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            Text { text: "Orbi " + root.version; color: #8E8E93; font-size: 12px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Abrir pasta dos dados"; clicked => { root.open-folder(); } }
        }
    }
}
