<UserControl x:Class="Orbi.TodoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource N.Fg}" FontFamily="Segoe UI">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource N.Field}" CornerRadius="8" Padding="8,4" Margin="0,0,4,6">
            <Grid>
                <TextBlock x:Name="Hint" Text="Nova tarefa… ex.: ligar pro João às 15:30" Foreground="#666" FontSize="12" IsHitTestVisible="False" Margin="2,0"/>
                <TextBox x:Name="Input" Background="Transparent" Foreground="{DynamicResource N.Fg}" CaretBrush="{DynamicResource N.Fg}" BorderThickness="0" FontSize="12"
                         AutomationProperties.Name="Nova tarefa" KeyDown="Input_KeyDown" TextChanged="Input_TextChanged"/>
            </Grid>
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="2,4,6,0">
            <TextBlock DockPanel.Dock="Right" Text="Limpar concluídas" FontSize="10.5" Foreground="#777" Cursor="Hand" MouseLeftButtonUp="ClearDone_Click"/>
            <TextBlock x:Name="CountText" FontSize="10.5" Foreground="#777"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Items"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
