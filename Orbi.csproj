<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Orbi</AssemblyName>
    <Version>1.2.1</Version>
    <ApplicationIcon>orbi.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);web/node_modules/**;tests/**;publish/**;dist/**;ci/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="orbi.ico" />
    <!-- Renderizador do avatar (@bible-strong/avatar-web). Gerar de novo: cd web && npm install && npm run build -->
    <EmbeddedResource Include="web/avatar.bundle.js" LogicalName="avatar.bundle.js" />
    <EmbeddedResource Include="web/new-avatar.avatar.json" LogicalName="default.avatar.json" />
  </ItemGroup>
</Project>
