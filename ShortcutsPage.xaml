<UserControl x:Class="Orbi.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource N.Fg}" FontFamily="Segoe UI">
    <DockPanel>
        <Border x:Name="UrlBox" DockPanel.Dock="Bottom" Background="{DynamicResource N.Field}" CornerRadius="8" Padding="8,4" Margin="0,6,4,0" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="UrlHint" Text="Cole o endereço do site e aperte Enter (Esc cancela)" Foreground="#666" FontSize="12" IsHitTestVisible="False" Margin="2,0"/>
                <TextBox x:Name="UrlInput" Background="Transparent" Foreground="{DynamicResource N.Fg}" CaretBrush="{DynamicResource N.Fg}" BorderThickness="0" FontSize="12"
                         AutomationProperties.Name="Endereço do site" KeyDown="UrlInput_KeyDown"
                         TextChanged="UrlInput_TextChanged"/>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="Items"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
