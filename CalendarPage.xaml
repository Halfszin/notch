<UserControl x:Class="Orbi.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource N.Fg}" FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="Small" TargetType="Button">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource N.Fg}"/>
                                <Setter TargetName="b" Property="Background" Value="#26262A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Preset" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Preset"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="7,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource N.Fg}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Calendário do mês -->
        <DockPanel Margin="4,0,10,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Click="Next_Click" AutomationProperties.Name="Próximo mês"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Click="Prev_Click" AutomationProperties.Name="Mês anterior"/>
                <TextBlock x:Name="MonthText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <UniformGrid x:Name="Days" Columns="7"/>
        </DockPanel>

        <Border Grid.Column="1" Background="{DynamicResource N.Track}" Margin="0,6"/>

        <!-- Timer (pomodoro) -->
        <Grid Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="EndsText" FontSize="11" Foreground="#777" HorizontalAlignment="Center" Text="timer"/>
            <TextBlock x:Name="TimeText" Grid.Row="1" Text="25:00" FontSize="40" FontWeight="Light"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Button x:Name="StartBtn" Click="Start_Click" Cursor="Hand" Focusable="False" AutomationProperties.Name="Iniciar ou pausar timer">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{DynamicResource N.Strong}" CornerRadius="14" Padding="16,4">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="StartText" Text="Iniciar" Foreground="{DynamicResource N.OnStrong}" FontSize="12" FontWeight="SemiBold"/>
                </Button>
                <Button Style="{StaticResource Small}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                        Margin="6,0,0,0" Click="Reset_Click" AutomationProperties.Name="Zerar timer"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Style="{StaticResource Preset}" Content="5m" Tag="5" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource Preset}" Content="15m" Tag="15" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource Preset}" Content="25m" Tag="25" IsChecked="True" Checked="Preset_Checked"/>
                <RadioButton Style="{StaticResource Preset}" Content="50m" Tag="50" Checked="Preset_Checked"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
