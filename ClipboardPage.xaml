<UserControl x:Class="Orbi.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource N.Fg}" FontFamily="Segoe UI">
    <Grid>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#666" HorizontalAlignment="Center"/>
            <TextBlock Text="Copie um texto ou um print (Ctrl+C, Win+Shift+S)" FontSize="13" Foreground="#AAA" Margin="0,10,0,2" HorizontalAlignment="Center"/>
            <TextBlock Text="Os últimos 20 aparecem aqui. Clique num item para copiar de novo." FontSize="11" Foreground="#666" HorizontalAlignment="Center"/>
        </StackPanel>
        <DockPanel x:Name="Filled" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="2,0,4,4">
                <TextBlock DockPanel.Dock="Right" Text="Limpar" FontSize="11" Foreground="#888" Cursor="Hand"
                           MouseLeftButtonUp="Clear_Click" AutomationProperties.Name="Limpar histórico"/>
                <TextBlock x:Name="Hint" Text="Clique para copiar de novo" FontSize="11" Foreground="#888"/>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Items"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
